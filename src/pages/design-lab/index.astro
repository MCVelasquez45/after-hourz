---
import BaseLayout from '../../layouts/BaseLayout.astro';

// The Design Lab hub. Routes to foundations + the three competing prototype directions.
// Prototypes not yet built are shown as status cards (no dead links) until approved.
const foundations = {
  href: '/design-lab/foundations/',
  label: 'Foundations',
  desc: 'Type, color, material, light, spacing, geometry — the token system, live.',
};

const prototypes = [
  {
    href: '/design-lab/prototypes/booth-light/',
    code: 'A',
    name: 'Booth Light',
    status: 'ready',
    thesis:
      'Near-black space, one controlled light, the finish revealed slowly. Depth over decoration.',
  },
  {
    href: null,
    code: 'B',
    name: 'Precision Machine',
    status: 'pending approval',
    thesis:
      'Engineered, technical, spec-plate rigor — the shop as a precision instrument. (Built after the Booth Light bar is approved.)',
  },
  {
    href: null,
    code: 'C',
    name: 'After Dark',
    status: 'pending approval',
    thesis:
      'The nocturnal, cinematic edge of custom car culture — the most atmospheric direction. (Built after approval.)',
  },
];
---

<BaseLayout title="Design Lab — After Hourz" description="Internal creative-development lab.">
  <div class="lab lab__booth">
    <header class="lab__masthead">
      <div class="lab__wrap lab__eyebrow">
        <p class="spec-label">After Hourz · Design Lab · internal · not the public site</p>
        <p class="spec-label">Three competing directions</p>
      </div>
    </header>

    <main id="main" class="lab__wrap" style="padding-block: var(--section-pad);">
      <div style="display:grid; gap:var(--spacing-md); max-width:var(--measure); margin-bottom:var(--spacing-2xl);">
        <p class="spec-label" style="color:var(--color-signal);">
          Design Lab
        </p>
        <h1 style="font-size:var(--text-h1);">Three directions, proven side by side</h1>
        <p style="color:var(--color-aluminum);">
          This is the internal laboratory. Below: the shared foundations, and three complete,
          competing creative directions for the After Hourz experience. We do not pick the homepage
          first — the directions prove themselves, then one is chosen with the client.
        </p>
      </div>

      <!-- Foundations -->
      <a
        href={foundations.href}
        class="hub-card hub-card--wide"
        style="text-decoration:none; display:block; margin-bottom:var(--spacing-xl);"
      >
        <span class="spec-label" style="color:var(--color-signal);">
          Foundations
        </span>
        <h2 style="font-size:var(--text-h3); margin-block:var(--spacing-2xs);">
          {foundations.label}
        </h2>
        <p style="color:var(--color-aluminum); max-width:var(--measure);">{foundations.desc}</p>
        <span class="hub-card__go">Open foundations →</span>
      </a>

      <p class="spec-label" style="margin-bottom:var(--spacing-sm);">
        Prototypes
      </p>
      <div class="hub-grid">
        {prototypes.map((p) =>
          p.href ? (
            <a href={p.href} class="hub-card hub-card--proto" style="text-decoration:none;">
              <div class="hub-card__top">
                <span class="hub-card__code">{p.code}</span>
                <span class="hub-card__status hub-card__status--ready">{p.status}</span>
              </div>
              <h3 style="font-size:var(--text-h3);">{p.name}</h3>
              <p style="color:var(--color-aluminum);">{p.thesis}</p>
              <span class="hub-card__go">Open prototype →</span>
            </a>
          ) : (
            <div class="hub-card hub-card--proto hub-card--pending" aria-disabled="true">
              <div class="hub-card__top">
                <span class="hub-card__code">{p.code}</span>
                <span class="hub-card__status">{p.status}</span>
              </div>
              <h3 style="font-size:var(--text-h3); color:var(--color-aluminum);">{p.name}</h3>
              <p style="color:var(--color-pewter);">{p.thesis}</p>
            </div>
          ),
        )}
      </div>
    </main>

    <footer class="lab__wrap" style="padding-block:var(--spacing-2xl); color:var(--color-pewter);">
      <p class="spec-label">
        Internal design lab · no production content · no client facts fabricated · DEPLOYED: NO
      </p>
    </footer>
  </div>
</BaseLayout>
