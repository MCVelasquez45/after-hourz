---
import BaseLayout from '../../layouts/BaseLayout.astro';

const prototypes = [
  {
    href: '/design-lab/prototypes/chrome-heritage/',
    code: '01',
    name: 'Chrome Heritage',
    thesis:
      'Custom automotive heritage rebuilt for a contemporary canvas — chrome, cobalt, ornament.',
    preview: 'ch',
  },
  {
    href: '/design-lab/prototypes/booth-light/',
    code: '02',
    name: 'Booth Light',
    thesis: 'Craft revealed under controlled inspection light — image-led, cinematic, near-black.',
    preview: 'bl',
  },
  {
    href: '/design-lab/prototypes/after-dark/',
    code: '03',
    name: 'After Dark',
    thesis:
      'SoCal craftsmanship when the doors stay open after sunset — warm, momentum, editorial.',
    preview: 'ad',
  },
];

const labs = [
  ['Foundations', '/design-lab/foundations/', 'Type · color · material · spacing · geometry'],
];
---

<BaseLayout title="Design Lab — After Hourz" description="Enterprise prototype lab.">
  <div class="lab lab__booth">
    <header class="lab__masthead">
      <div class="lab__wrap lab__eyebrow">
        <p class="spec-label">After Hourz · Enterprise Prototype Lab</p>
        <p class="spec-label">Three directions · compare &amp; choose</p>
      </div>
    </header>

    <main id="main" class="lab__wrap" style="padding-block: var(--section-pad);">
      <div style="max-width:var(--measure); margin-bottom:var(--spacing-2xl); display:grid; gap:var(--spacing-md);">
        <p class="spec-label" style="color:var(--color-signal);">
          After Hourz
        </p>
        <h1 style="font-size:var(--text-h1);">Enterprise Prototype Lab</h1>
        <p style="color:var(--color-aluminum);">
          Three complete, competing creative directions for the After Hourz experience — each a
          real, openable website prototype. Compare them; a direction is chosen with the client, not
          here.
        </p>
      </div>

      <div class="proto-grid">
        {prototypes.map((p) => (
          <a href={p.href} class="proto-panel" data-reveal>
            <div class={`proto-preview proto-preview--${p.preview}`} aria-hidden="true">
              <span class="proto-preview__mark">AFTER HOURZ</span>
            </div>
            <div class="proto-panel__body">
              <div class="proto-panel__top">
                <span class="proto-panel__code">{p.code}</span>
                <span class="proto-panel__status">ready</span>
              </div>
              <h2>{p.name}</h2>
              <p>{p.thesis}</p>
              <span class="hub-card__go">Open prototype →</span>
            </div>
          </a>
        ))}
      </div>

      <p class="spec-label" style="margin:var(--spacing-2xl) 0 var(--spacing-sm);">
        Supporting labs
      </p>
      <div class="hub-grid">
        {labs.map(([name, href, desc]) => (
          <a href={href} class="hub-card" style="text-decoration:none;">
            <h3 style="font-size:var(--text-h4); color:var(--color-chrome);">{name}</h3>
            <p style="color:var(--color-aluminum); margin-top:var(--spacing-2xs);">{desc}</p>
            <span class="hub-card__go">Open →</span>
          </a>
        ))}
      </div>
    </main>

    <footer class="lab__wrap" style="padding-block:var(--spacing-2xl); color:var(--color-pewter);">
      <p class="spec-label">
        Internal design lab · no production content · no client facts fabricated · DEPLOYED: NO
      </p>
    </footer>
  </div>
</BaseLayout>
