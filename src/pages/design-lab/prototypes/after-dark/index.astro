---
import PrototypeLayout from '../../../../layouts/PrototypeLayout.astro';
import '../../../../styles/prototype-after-dark.css';

/*
  AFTER HOURZ — AFTER DARK · production-level direction prototype (Design Lab).

  RE-CONCEPT (post-gate): this direction is NOT "Chrome Heritage at night."
  Thesis: THE NIGHT DRIVE. A cool-dominant night world — deep teal/blue wet-asphalt
  ambient — where craft is READ by found night light. Warm sodium survives ONLY as
  small, contained practical pools (a single lamp, a taillight), never as the UI/CTA.
  The interface accent is COOL (electric night-blue). Motion = DIRECTIONAL FLOW:
  connected rules that drift, section entrances that slide along a continuous line.

  Distinct from the other two on purpose:
  - Chrome Heritage = warm-dominant world, warm CTA. After Dark = cool-dominant, cool CTA.
  - Booth Light = the reveal is EXPOSURE (light switched on in a booth).
    After Dark = the reveal is REFLECTION ("the truth is in the reflection") —
    work read on wet asphalt / under a single streetlight.
  - Services here is a NIGHT-DRIVE FILMSTRIP (horizontal, image-led), NOT a numbered ledger.
  - Gallery here is a single-column large-format vertical reflection scroll, NOT a grid.

  PROVENANCE / TRUTH RULES (non-negotiable):
  - Every external photo is PROTOTYPE REFERENCE — never Anthony's completed work.
    ONE clear provenance caption per image block (not a badge on every tile).
  - No fabricated business facts. Phone/address/social/hours = CLIENT INPUT REQUIRED.
  - Craft lane only: custom paint / body / restoration on classic + custom vehicles.
    Modern EV/supercar framing intentionally DROPPED.
  - SoCal only. No NorCal text/maps/badges.
*/

const P = '/assets/prototype';

// ---- Services · the night-drive filmstrip (image-led, one practical light each) ----
// Each frame is a craft lane lit by a single found light, name burned into the lower-third.
const lanes = [
  {
    src: `${P}/materials-detail/blue-metalflake-clearcoat-waterbead-IqPGeGbBROY.jpg`,
    w: 2400,
    h: 1200,
    t: 'Custom Paint',
    d: 'Color changes, candy and flake, pinstripe and refinishing — laid down in patient layers until the reflection runs straight down the body line.',
    meta: 'Candy · flake · pinstripe',
    alt: 'Deep candy-blue metalflake clearcoat panel beaded with water, a single hard specular streak raking across the wet surface in the dark.',
  },
  {
    src: `${P}/materials-detail/graphite-body-panel-headlight-bezel-Mx_Oe-dv4H8.jpg`,
    w: 2400,
    h: 1695,
    t: 'Body Work',
    d: 'Collision repair, rust and fabrication, panel alignment and gap-setting — the metal made true before a drop of color goes down.',
    meta: 'Collision · fabrication · panel',
    alt: 'Cool graphite body panel and headlight bezel photographed in low light, one specular rake reading the body line out of the dark.',
  },
  {
    src: `${P}/booth-process/bare-metal-classic-body-restoration-cD7nA_pqj6E.jpg`,
    w: 2400,
    h: 1603,
    t: 'Restoration',
    d: 'Classics and customs brought back and brought forward — cars, trucks, and bikes returned to the road with the details right.',
    meta: 'Classic · custom · frame-off',
    alt: 'A bare-metal classic car body mid-restoration, stripped panels catching a single low light — the shell made true before any color goes down.',
  },
  {
    src: `${P}/culture-vehicles/craftsman-polisher-dark-portrait-M5lsL2E4ot0.jpg`,
    w: 2400,
    h: 3200,
    t: 'Detail & Polish',
    d: 'Cut, buff, and finish work that makes the paint read like glass — the last honest inch of a build, worked by hand under one light.',
    meta: 'Cut · buff · protect',
    alt: 'A craftsman works a dual-action polisher across a black panel in a dark studio, one hard light raking the wet-look finish.',
  },
];

// ---- Work / builds — single-column reflection scroll. "The truth is in the reflection." ----
// Each entry is a large-format frame; craft is READ by found night light on wet/gloss surfaces.
const reflections = [
  {
    src: `${P}/materials-detail/near-black-body-line-study-fBjCurUh-9w.jpg`,
    w: 2400,
    h: 4266,
    ratio: 'tall',
    k: 'The reflection reads the work',
    t: 'Near-black body line',
    d: 'One soft source runs the length of a near-black panel. If the reflection bends, the metal is not true yet. This is how the shop judges a finish — not by color, by the line the light draws.',
    alt: 'A near-black body panel emerging from darkness, a single soft reflection tracing the body line across the metal.',
  },
  {
    src: `${P}/environment-dusk/black-sedan-station-canopy-wet-gloss-night-fngi9wSSpms.jpg`,
    w: 2400,
    h: 3593,
    ratio: 'tall',
    k: 'Wet asphalt · doubled light',
    t: 'The street as a mirror',
    d: 'After the doors roll down, the wet ground doubles every light. Cool ambient everywhere, one warm pool where the canopy lamp lands — the exact key After Dark grades every frame to.',
    alt: 'A dark sedan under a lit station canopy on a wet night, its gloss and the mirror-black ground doubling the cool ambient and one warm pool of canopy light.',
  },
  {
    src: `${P}/materials-detail/blue-metalflake-clearcoat-waterbead-IqPGeGbBROY.jpg`,
    w: 2400,
    h: 1200,
    ratio: 'wide',
    k: 'Reflection on the paint',
    t: 'Candy under one light',
    d: 'A genuine wet-night panel macro — reflection on the paint, not a lit sign. Water beads sit proud of a candy-flake clear while a single specular streak proves the depth is real, not painted on.',
    alt: 'Macro of a candy-blue metalflake clearcoat beaded with water, a single hard specular streak crossing the wet finish.',
  },
];

// ---- Process arc — the night drive: strip → metal → color → cut/buff ----
const process = [
  {
    n: '01',
    t: 'Strip & assess',
    d: 'An honest read on the metal. What is real, what is filler, what has to be cut out and rebuilt.',
  },
  {
    n: '02',
    t: 'Metal & body',
    d: 'Panels aligned, gaps set, primer blocked flat. The finish only ever shows what is underneath.',
  },
  {
    n: '03',
    t: 'Base · candy · clear',
    d: 'Color goes down in patient layers — base, candy, flake, clear — until the depth is real, not painted on.',
  },
  {
    n: '04',
    t: 'Cut & buff',
    d: 'Sanded flat and buffed back up so the reflection runs straight down the body line. Then it rolls out.',
  },
];
---

<PrototypeLayout
  title="After Hourz — After Dark"
  description="After Dark design direction for After Hourz: a cool-dominant Southern California night world where custom-car craft is read by found night light. Design Lab prototype — reference imagery, not client work."
  bodyClass="ad"
>
  <!-- Lab chrome — subtle return affordance (suppressed later in client-review mode) -->
  <div class="ad-lab">
    <div class="ad-shell ad-lab__row">
      <span class="ad-lab__tag">Design Lab · Prototype · After Dark · not client-approved</span>
      <a class="ad-lab__back" href="/design-lab/">
        <span aria-hidden="true">&larr;</span> Design Lab
      </a>
    </div>
  </div>

  <!-- ================= NAV ================= -->
  <header class="ad-nav" id="top" data-scrolled="false">
    <div class="ad-shell ad-nav__row">
      <a class="ad-wordmark" href="#top" aria-label="After Hourz — home">
        AFTER
        <span class="ad-wordmark__z">
          HOUR<b>Z</b>
        </span>
      </a>

      <nav class="ad-nav__links" aria-label="Primary">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#process">Process</a>
        <a href="#story">Story</a>
        <a href="#contact">Contact</a>
      </nav>

      <a class="ad-btn ad-btn--accent ad-nav__cta" href="#contact">
        Request a Quote
      </a>

      <button
        class="ad-menu-btn"
        id="ad-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="ad-mobile-menu"
      >
        <span class="ad-menu-btn__bars" aria-hidden="true"></span>
        <span class="ad-sr">Menu</span>
      </button>
    </div>

    <!-- Mobile menu (keyboard-operable; JS-enhanced, focus-managed) -->
    <div class="ad-mobile" id="ad-mobile-menu" hidden>
      <nav class="ad-mobile__nav" aria-label="Mobile">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#process">Process</a>
        <a href="#story">Story</a>
        <a href="#contact">Contact</a>
        <a class="ad-btn ad-btn--accent ad-mobile__cta" href="#contact">
          Request a Quote
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ================= HERO ================= -->
    <section class="ad-hero" aria-labelledby="hero-h">
      <div class="ad-hero__media">
        <img
          class="ad-hero__img"
          src={`${P}/environment-dusk/vintage-truck-foggy-gas-station-night-o2GgDamhkQA.jpg`}
          width="2400"
          height="4267"
          alt="A vintage pickup truck at a fog-shrouded gas station late at night — cool blue fog fills the frame while the station canopy pools one warm light over the wet, mirror-black asphalt."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="ad-hero__grade" aria-hidden="true"></div>
        <span class="ad-refbadge ad-hero__ref">Reference imagery</span>
      </div>

      <div class="ad-shell ad-hero__inner">
        <div class="ad-hero__panel" data-reveal>
          <p class="ad-eyebrow">Southern California · after dark</p>
          <h1 class="ad-hero__h1" id="hero-h">
            The work
            <br />
            <span class="ad-hero__flow">reads in the</span>
            <br />
            reflection
          </h1>
          <p class="ad-hero__kicker">
            Custom paint · body work · restoration — Southern California
          </p>
          <p class="ad-hero__sub">
            Cars, trucks, and bikes finished the way the West Coast builds them: patient,
            hand-worked, and judged by the line one light draws down a wet panel.
          </p>
          <div class="ad-hero__actions">
            <a class="ad-btn ad-btn--accent ad-btn--lg" href="#contact">
              Request a Quote{' '}
              <span class="ad-arw" aria-hidden="true">
                &rarr;
              </span>
            </a>
            <a class="ad-btn ad-btn--ghost ad-btn--lg" href="#work">
              See the work
            </a>
          </div>
        </div>
      </div>

      <p class="ad-hero__prov">Prototype reference imagery — not a real After Hourz build.</p>
    </section>

    <!-- ================= SERVICES · night-drive filmstrip ================= -->
    <section class="ad-services" id="services" aria-labelledby="svc-h">
      <div class="ad-shell">
        <div class="ad-sechead">
          <p class="ad-eyebrow">Services</p>
          <h2 class="ad-secttl" id="svc-h">
            Four lanes, one night
          </h2>
          <p class="ad-seclead">
            Roll the strip. Each frame is a craft lane lit by a single found light — the same honest
            arc every build runs: metal true first, color last.
          </p>
        </div>
      </div>

      <!-- Horizontal, image-led filmstrip. Shares NO silhouette with a numbered ledger. -->
      <div
        class="ad-strip"
        id="ad-strip"
        tabindex="0"
        role="group"
        aria-label="Service lanes — scroll horizontally through the filmstrip"
      >
        <ul class="ad-strip__track" role="list">
          {lanes.map((s) => (
            <li class="ad-frame">
              <figure class="ad-frame__fig">
                <div class="ad-frame__media">
                  <img
                    src={s.src}
                    width={s.w}
                    height={s.h}
                    alt={s.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="ad-frame__practical" aria-hidden="true"></span>
                  <div class="ad-frame__scrim" aria-hidden="true"></div>
                  <figcaption class="ad-frame__cap">
                    <span class="ad-frame__meta">{s.meta}</span>
                    <h3 class="ad-frame__t">{s.t}</h3>
                    <p class="ad-frame__d">{s.d}</p>
                  </figcaption>
                </div>
              </figure>
            </li>
          ))}
        </ul>
      </div>
      <div class="ad-shell">
        <p class="ad-strip__foot">
          <span class="ad-strip__hint" aria-hidden="true">
            Drag / scroll the strip &rarr;
          </span>
          <span class="ad-prov">
            Prototype reference imagery — direction, not After Hourz builds.
          </span>
        </p>
      </div>
    </section>

    <!-- ================= WORK · single-column reflection scroll ================= -->
    <section class="ad-work" id="work" aria-labelledby="work-h">
      <div class="ad-shell">
        <div class="ad-sechead ad-sechead--split">
          <div>
            <p class="ad-eyebrow">Work · the reflection</p>
            <h2 class="ad-secttl" id="work-h">
              The truth is in the reflection
            </h2>
          </div>
          <p class="ad-seclead">
            One frame at a time, read by found night light.
            <span class="ad-provclause">
              {' '}
              The images below are
              <strong>prototype reference</strong> — the direction, not After Hourz builds. Real
              work and process shots: <span class="ad-cir">Client input required</span>.
            </span>
          </p>
        </div>
      </div>

      <!-- Single column, hard negative space between frames -->
      <div class="ad-reflect">
        {reflections.map((r, i) => (
          <figure class={`ad-refl ad-refl--${r.ratio}`} data-reveal>
            <div class="ad-refl__media">
              <img
                src={r.src}
                width={r.w}
                height={r.h}
                alt={r.alt}
                loading="lazy"
                decoding="async"
              />
              <div class="ad-refl__pool" aria-hidden="true"></div>
            </div>
            <figcaption class="ad-refl__cap">
              <span class="ad-refl__idx" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="ad-refl__text">
                <span class="ad-refl__k">{r.k}</span>
                <span class="ad-refl__t">{r.t}</span>
                <p class="ad-refl__d">{r.d}</p>
                <span class="ad-prov">Prototype reference · stock · not client work</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ================= PROCESS · the night drive (flow line) ================= -->
    <section class="ad-process" id="process" aria-labelledby="proc-h">
      <div class="ad-shell">
        <div class="ad-sechead">
          <p class="ad-eyebrow">Process · the night drive</p>
          <h2 class="ad-secttl" id="proc-h">
            Strip → metal → color → cut
          </h2>
          <p class="ad-seclead">
            The build moves in one direction, like a drive across town after midnight. Four stops,
            one continuous line — it holds still if you prefer reduced motion.
          </p>
        </div>
      </div>

      <ol class="ad-drive" role="list">
        {process.map((p, i) => (
          <li class="ad-leg" data-reveal style={`--i:${i}`}>
            <span class="ad-leg__node" aria-hidden="true"></span>
            <span class="ad-leg__n">{p.n}</span>
            <h3 class="ad-leg__t">{p.t}</h3>
            <p class="ad-leg__d">{p.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ================= STORY ================= -->
    <section class="ad-story" id="story" aria-labelledby="story-h">
      <div class="ad-story__bg" aria-hidden="true"></div>
      <div class="ad-shell ad-story__grid">
        <div class="ad-story__copy" data-reveal>
          <p class="ad-eyebrow">The shop</p>
          <h2 class="ad-secttl" id="story-h">
            The finish speaks. The copy stays quiet.
          </h2>
          <p class="ad-story__lead">
            After Hourz is Southern California custom-car work — body, paint, and restoration for
            people who care how the light runs down a panel.
          </p>
          <p class="ad-story__p">
            The name is the method. When the lot clears and the world goes home, the real work
            starts: no rush, no audience, one light on the metal until the reflection is straight
            and the gaps are right.
          </p>
          <p class="ad-story__note">
            <span class="ad-cir">Client input required</span> — owner bio, shop history, and
            founding year. Nothing here is invented; the voice is a placeholder for Anthony&rsquo;s
            own words.
          </p>
        </div>

        <figure class="ad-story__fig" data-reveal="side">
          <div class="ad-story__media">
            <img
              src={`${P}/culture-vehicles/craftsman-polisher-dark-portrait-M5lsL2E4ot0.jpg`}
              width="2400"
              height="3200"
              alt="A craftsman leans into a black panel with a dual-action polisher in a dark studio, one hard light raking the wet-look finish."
              loading="lazy"
              decoding="async"
            />
            <div class="ad-refl__pool" aria-hidden="true"></div>
          </div>
          <figcaption class="ad-story__figcap">
            Prototype reference · stock — not Anthony. Real portraits:
            <span class="ad-cir">Client input required</span>.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ================= CONTACT / QUOTE ================= -->
    <section class="ad-contact" id="contact" aria-labelledby="contact-h">
      <div class="ad-contact__glow" aria-hidden="true"></div>
      <div class="ad-shell ad-contact__grid">
        <div class="ad-contact__intro">
          <p class="ad-eyebrow">Request a quote</p>
          <h2 class="ad-secttl" id="contact-h">
            Tell us what you&rsquo;re building.
          </h2>
          <p class="ad-contact__lead">
            We&rsquo;ll give you an honest read on the work — no pressure, no upsell.
          </p>

          <dl class="ad-channels">
            <div class="ad-channel">
              <dt>Phone</dt>
              <dd>
                <span class="ad-cir">Client input required</span>
              </dd>
            </div>
            <div class="ad-channel">
              <dt>Location</dt>
              <dd>
                Southern California{' '}
                <span class="ad-channel__sub">
                  (exact address — <span class="ad-cir">client input required</span>)
                </span>
              </dd>
            </div>
            <div class="ad-channel">
              <dt>Instagram</dt>
              <dd>
                <span class="ad-cir">Client input required</span>
              </dd>
            </div>
          </dl>
        </div>

        <form class="ad-form" id="ad-form" novalidate aria-labelledby="form-h">
          <p class="ad-form__h" id="form-h">
            Quote request
          </p>

          <div class="ad-field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="ad-field">
            <label for="f-vehicle">
              Vehicle <span class="ad-field__hint">Year · make · model</span>
            </label>
            <input id="f-vehicle" name="vehicle" type="text" autocomplete="off" required />
          </div>

          <div class="ad-field">
            <label for="f-service">Service</label>
            <div class="ad-select">
              <select id="f-service" name="service" required>
                <option value="" selected>
                  Choose a lane…
                </option>
                <option value="paint">Custom paint</option>
                <option value="body">Body work</option>
                <option value="restoration">Restoration</option>
                <option value="detail">Detail &amp; polish</option>
                <option value="other">Something else</option>
              </select>
              <span class="ad-select__arw" aria-hidden="true">
                &#9662;
              </span>
            </div>
          </div>

          <div class="ad-field">
            <label for="f-msg">What do you want done?</label>
            <textarea
              id="f-msg"
              name="message"
              rows="4"
              placeholder="Paint, bodywork, restoration — tell us the vision."
              required
            ></textarea>
          </div>

          <button class="ad-btn ad-btn--accent ad-btn--block" type="submit">
            Send request{' '}
            <span class="ad-arw" aria-hidden="true">
              &rarr;
            </span>
          </button>

          <p class="ad-form__ack" id="ad-form-ack" role="status" aria-live="polite" hidden>
            Prototype — this form isn&rsquo;t wired to a backend yet. Nothing was sent. Real
            submission handling: <span class="ad-cir">client input required</span>.
          </p>
          <p class="ad-form__fine">
            Prototype form · no data leaves your browser · no backend connected.
          </p>
        </form>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="ad-footer">
    <div class="ad-shell ad-footer__grid">
      <div class="ad-footer__brand">
        <span class="ad-wordmark ad-wordmark--foot">
          AFTER
          <span class="ad-wordmark__z">
            HOUR<b>Z</b>
          </span>
        </span>
        <p class="ad-footer__tag">Custom paint · body work · restoration — Southern California.</p>
      </div>

      <nav class="ad-footer__nav" aria-label="Footer">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#process">Process</a>
        <a href="#story">Story</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="ad-footer__meta">
        <p class="ad-footer__prov">
          Prototype — reference imagery, not client work. All photography is stock used to study the
          direction.
        </p>
        <p class="ad-footer__cir">
          Contact facts (phone · address · social · hours):
          <span class="ad-cir">Client input required</span>.
        </p>
        <a class="ad-footer__lab" href="/design-lab/">
          &larr; Design Lab
        </a>
      </div>
    </div>
  </footer>

  <!-- ================= STICKY MOBILE CONTACT BAR ================= -->
  <div class="ad-dock" aria-label="Quick contact">
    <a class="ad-dock__call" href="#contact">
      <span class="ad-dock__ico" aria-hidden="true">
        &#9990;
      </span>
      <span class="ad-dock__label">
        Call<span class="ad-dock__note">Client input required</span>
      </span>
    </a>
    <a class="ad-dock__quote ad-btn ad-btn--accent" href="#contact">
      Request a Quote
    </a>
  </div>

  <!-- ================= ISOLATED JS (menu · nav state · form) ================= -->
  <script>
    // Nav condensed state on scroll (progressive; class only, no layout dep)
    const nav = document.querySelector<HTMLElement>('.ad-nav');
    if (nav) {
      const onScroll = () => nav.setAttribute('data-scrolled', String(window.scrollY > 24));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Mobile menu — keyboard-operable, focus-managed, Escape closes, restores focus
    const btn = document.getElementById('ad-menu-btn');
    const menu = document.getElementById('ad-mobile-menu');
    if (btn && menu) {
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
        document.body.classList.toggle('ad-menu-open', open);
      };
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        setOpen(!open);
        if (!open) {
          const first = menu.querySelector<HTMLElement>('a');
          first?.focus();
        }
      });
      // Close on link tap + on Escape (restore focus to the toggle)
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          btn.focus();
        }
      });
    }

    // Prototype quote form — preventDefault + tasteful acknowledgement (no backend)
    const form = document.getElementById('ad-form') as HTMLFormElement | null;
    const ack = document.getElementById('ad-form-ack');
    if (form && ack) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        ack.hidden = false;
        ack.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    }
  </script>
</PrototypeLayout>
