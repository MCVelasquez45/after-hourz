---
import PrototypeLayout from '../../../../layouts/PrototypeLayout.astro';
import BrandMark from '../../../../components/brand/BrandMark.astro';
import '../../../../styles/prototype-after-dark.css';

/*
  AFTER HOURZ — AFTER DARK · production-level direction prototype (Design Lab).

  ONE BRAND, THREE EDITIONS. After Dark is the STREET / CRUISE edition of the LOCKED
  After Hourz identity — AUTHENTIC SoCal LOWRIDER culture at night.

  THESIS: Southern California LOWRIDER culture AFTER DARK. Candy Impalas and Regals on
  GOLD and CHROME wire-spoke wheels, low stance, hydraulics and three-wheel, whitewalls,
  gold-leaf and pinstripe under streetlight. The boulevard is the gallery: cruising, car
  meets, plaque culture, wet asphalt doubling every taillight. Not a premium enterprise
  car site — a lowrider site.

  BRAND-ANCHORED (locked family, plus the shared lowrider system):
  - Palette = BLACK + CHROME + CANDY COBALT + GOLD. Gold is essential to lowrider —
    it lives in pinstripe frames, plaque borders, and the script accent. Tokens = --ah-*
    (brand) + --lr-* (candy / gold / chrome) from lowrider.css. Warm practical light also
    lives inside the photography (dusk sky, sodium, taillights, gold leaf).
  - Logo = the REAL client chrome Old-English lettering via BrandMark (lockup in hero,
    wordmark in nav + footer). It already reads lowrider. No fake text wordmark.
  - Ornament is GOOD here (the poster is dense/ornate): PLAQUE buttons (.ah-btn), gold
    .ah-pinstripe rules, .ah-plaque chrome+gold frames, a Yellowtail .ah-script accent.
  - Motion = MOMENTUM: a slow cinematic hero push, a passing light sweep, a horizontal
    night-drive filmstrip, a directional reveal drift. All frozen under reduced motion;
    content fails OPEN (never trapped at opacity 0).

  DISTINCT FROM THE OTHER TWO ON PURPOSE:
  - Chrome Heritage = heritage build-sheet ledger, warm candy accent, studio chrome.
  - Booth Light = clinical inspection light, high-key reveal, macro clearcoat.
  - After Dark = the LOWRIDER BOULEVARD after dark — candy + wire wheels + stance,
    cruising, hydraulics, plaque culture, gold under streetlight.

  PROVENANCE / TRUTH RULES (non-negotiable):
  - Every external photo is PROTOTYPE REFERENCE — never Anthony's completed work.
  - No fabricated business facts. Phone / address / social / hours = CLIENT INPUT REQUIRED.
  - Craft lane only: custom paint / body / restoration on classic + custom vehicles.
  - SoCal only. No NorCal text/maps/badges/QUINCY.
*/

const P = '/assets/prototype';

// ---- Services · the night-drive filmstrip (image-led, one practical light each) ----
// Each frame is a craft lane, shown on a REAL lowrider — candy + gold-leaf + wire wheels
// + hydraulics — name burned into the lower-third.
const lanes = [
  {
    src: `${P}/lowrider/lincoln-candy-red-goldleaf-hood-mural-01-80Izckypu88.jpg`,
    w: 2400,
    h: 1600,
    t: 'Custom Paint',
    d: 'Candy and metalflake, gold-leaf and pinstripe, murals and lettering — laid down in patient layers until the paint has real depth, not painted-on shine.',
    meta: 'Candy · gold-leaf · pinstripe',
    alt: 'A candy red Lincoln lowrider with a gold-leaf and pinstripe hood mural, deep candy paint catching the light.',
  },
  {
    src: `${P}/lowrider/impala-blue-candy-chromewheel-pinstripe-01-y-Ye8UI6a5U.jpg`,
    w: 2400,
    h: 1600,
    t: 'Body Work',
    d: 'Panel work, gap-setting and metal made true, straight body lines that carry candy without a ripple — the foundation every wet-look finish is built on.',
    meta: 'Panel · gaps · straight metal',
    alt: 'The side of a blue candy Impala lowrider on a chrome wire wheel, purple pinstripe murals running down a mirror-straight body line.',
  },
  {
    src: `${P}/lowrider/montecarlo-black-hydraulics-front-up-01-xpRfkVs09MM.jpg`,
    w: 2400,
    h: 1600,
    t: 'Restoration & Hydraulics',
    d: 'Classics and customs brought back and set up right — frame-off restoration, chrome undercarriage, hydraulics and three-wheel dialed to hit clean.',
    meta: 'Frame-off · chrome · hydraulics',
    alt: 'A black Monte Carlo lowrider on hydraulics with the front end lifted, chrome wire wheels and a low stance against a SoCal sky.',
  },
  {
    src: `${P}/lowrider/goldwheel-chrome-whitewall-sunflare-macro-01-obYxajIGaVs.jpg`,
    w: 2400,
    h: 3622,
    t: 'Chrome & Gold Detail',
    d: 'Engraved gold-and-chrome wire wheels, whitewalls, cut-and-buff so the finish reads like glass — the last honest inch that separates a build from a car.',
    meta: 'Wire wheels · cut · buff',
    alt: 'A sunlit gold-and-chrome wire-spoke wheel with a whitewall tire, star flares glinting off the polished spokes.',
  },
];

// ---- Work / builds — single-column reflection scroll on the boulevard after dark. ----
// Each entry is a large-format REAL lowrider night frame — candy + wire wheels + stance.
const reflections = [
  {
    src: `${P}/lowrider/impala-61-red-rear-night-taillights-01-eu9BLGXK44E.jpg`,
    w: 2400,
    h: 1600,
    ratio: 'wide',
    k: 'The boulevard after dark',
    t: 'Taillights on wet asphalt',
    d: 'A candy ’61 Impala sitting low at night, triple taillights glowing and doubling in the wet street. When the lot clears and the boulevard opens up, the ground turns to a mirror — every light, every line of the body, read twice. This is the exact cinematic key After Dark grades every frame to.',
    alt: 'The low rear of a red 1961 Impala lowrider at night, triple taillights glowing over a low stance on the dark street.',
  },
  {
    src: `${P}/lowrider/regal-green-night-goldwheel-doors-open-01-J3vo0W5buXc.jpg`,
    w: 2400,
    h: 3491,
    ratio: 'tall',
    k: 'Gold under streetlight',
    t: 'Gold wheels, doors up',
    d: 'A candy green Regal parked out at night, doors open, gold wire wheels and pinstripe catching the streetlight. This is the culture the finish is built for — the meet, the plaque, the car sitting clean where people can see it. Gold and chrome do the talking after dark.',
    alt: 'A candy green Buick Regal lowrider at night with its doors open, gold wire-spoke wheels and pinstripe glinting under a streetlight.',
  },
  {
    src: `${P}/lowrider/impala-63-black-dusk-goldwheels-sunset-01-wxYh-8OMPO4.jpg`,
    w: 2400,
    h: 3611,
    ratio: 'tall',
    k: 'Stance reads the build',
    t: 'Low against the sunset',
    d: 'A black ’63 Impala sitting low on gold wire wheels against a pink SoCal sunset. Stance is the signature — how low it sits, how the wheels tuck, how the body line runs level from bumper to bumper. If the car sits right at rest, the build is right.',
    alt: 'A black 1963 Impala lowrider sitting low on gold wire-spoke wheels against a pink Southern California sunset sky.',
  },
];

// ---- Process arc — the build: strip → metal → candy & gold → wheels & setup ----
const process = [
  {
    n: '01',
    t: 'Strip & assess',
    d: 'An honest read on the metal. What is real, what is filler, what has to be cut out and rebuilt before the car earns candy.',
  },
  {
    n: '02',
    t: 'Metal & body',
    d: 'Panels aligned, gaps set, primer blocked dead flat. Candy shows everything underneath, so the body has to be true first.',
  },
  {
    n: '03',
    t: 'Candy · flake · gold-leaf',
    d: 'Color goes down in patient layers — base, candy, metalflake, clear — then pinstripe and gold-leaf by hand until the depth is real.',
  },
  {
    n: '04',
    t: 'Wheels & setup',
    d: 'Gold-and-chrome wire wheels, whitewalls, hydraulics or bags dialed in — the stance set so it sits clean and hits right. Then it rolls out.',
  },
];

const navLinks = [
  ['#services', 'Services'],
  ['#work', 'Work'],
  ['#process', 'Process'],
  ['#story', 'Story'],
  ['#contact', 'Contact'],
];
---

<PrototypeLayout
  title="After Hourz — After Dark"
  description="After Dark design direction for After Hourz: Southern California custom-car culture after dark, in the locked black / chrome / cobalt brand family. Design Lab prototype — reference imagery, not client work."
  bodyClass="ad"
>
  <!-- Lab chrome — subtle return affordance (suppressed later in client-review mode) -->
  <div class="ad-lab">
    <div class="ad-shell ad-lab__row">
      <span class="ad-lab__tag">Design Lab · Prototype · After Dark · not client-approved</span>
      <a class="ad-lab__back" href="/design-lab/">
        <span aria-hidden="true">&larr;</span> Design Lab
      </a>
    </div>
  </div>

  <!-- ================= NAV ================= -->
  <header class="ad-nav" id="top" data-scrolled="false">
    <div class="ad-shell ad-nav__row">
      <a class="ad-brand ad-brand--nav" href="#top" aria-label="After Hourz — home">
        <BrandMark variant="wordmark" width={168} loading="eager" fetchpriority="high" />
      </a>

      <nav class="ad-nav__links" aria-label="Primary">
        {navLinks.map(([href, label]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>

      <a class="ah-btn ah-btn--candy ad-nav__cta" href="#contact">
        Request a Quote
      </a>

      <button
        class="ad-menu-btn"
        id="ad-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="ad-mobile-menu"
      >
        <span class="ad-menu-btn__bars" aria-hidden="true"></span>
        <span class="ad-sr">Menu</span>
      </button>
    </div>

    <!-- Mobile menu (keyboard-operable; JS-enhanced, focus-managed) -->
    <div class="ad-mobile" id="ad-mobile-menu" hidden>
      <nav class="ad-mobile__nav" aria-label="Mobile">
        {navLinks.map(([href, label]) => (
          <a href={href}>{label}</a>
        ))}
        <a class="ah-btn ah-btn--candy ad-mobile__cta" href="#contact">
          Request a Quote
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ================= HERO ================= -->
    <!-- Composed PHOTOGRAPHY-FIRST around an unmistakable LOWRIDER on the move: a candy
         magenta Buick Regal cruising golden hour, gold pinstripe flames, chrome wire
         wheels, low stance, people inside. The car reads center/right; the sky + trees
         top-left are the negative space the type is set into. This is the CRUISE edition. -->
    <section class="ad-hero" aria-labelledby="hero-h">
      <div class="ad-hero__media">
        <img
          class="ad-hero__img"
          src={`${P}/lowrider/regal-candy-magenta-cruise-goldenhour-hero-01-lGI79xj9EfA.jpg`}
          width="2400"
          height="1600"
          alt="A candy magenta Buick Regal lowrider cruising a Southern California boulevard at golden hour, gold pinstripe flames down the body, chrome wire-spoke wheels and whitewalls, sitting low with two people inside."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="ad-hero__grade" aria-hidden="true"></div>
        <div class="ad-hero__sweep" aria-hidden="true"></div>
        <span class="ad-refbadge ad-hero__ref">Reference imagery</span>
      </div>

      <div class="ad-shell ad-hero__inner">
        <div class="ad-hero__panel" data-reveal>
          <BrandMark
            variant="lockup"
            width={300}
            class="ad-brand ad-brand--hero"
            loading="eager"
            fetchpriority="high"
          />
          <p class="ad-eyebrow">Southern California · lowrider culture</p>
          <p class="ad-script ad-hero__script">Low &amp; slow</p>
          <h1 class="ad-hero__h1" id="hero-h">
            <span class="ad-hero__l1">Candy, chrome</span>
            <span class="ad-hero__flow">&amp; gold after dark</span>
          </h1>
          <hr class="ah-pinstripe ad-hero__stripe" />
          <p class="ad-hero__kicker">
            Custom paint · body work · restoration — Southern California
          </p>
          <p class="ad-hero__sub">
            Candy and metalflake, gold-leaf and pinstripe, wire wheels and hydraulics — classic and
            custom builds finished the way the West Coast has always done it: low, clean, and built
            to cruise.
          </p>
          <div class="ad-hero__actions">
            <a class="ah-btn ah-btn--candy" href="#contact">
              Request a Quote{' '}
              <span class="ad-arw" aria-hidden="true">
                &rarr;
              </span>
            </a>
            <a class="ah-btn ah-btn--ghost" href="#work">
              See the work
            </a>
          </div>
        </div>
      </div>

      <p class="ad-hero__prov">Prototype reference imagery — not a real After Hourz build.</p>
    </section>

    <!-- ================= SERVICES · night-drive filmstrip ================= -->
    <section class="ad-services" id="services" aria-labelledby="svc-h">
      <div class="ad-shell">
        <div class="ad-sechead">
          <p class="ad-eyebrow">Services</p>
          <h2 class="ad-secttl" id="svc-h">
            What we build
          </h2>
          <p class="ad-seclead">
            Roll the strip. Every lane runs the same honest arc — metal true first, candy and gold
            last — from a bare shell to a car that sits low and hits clean.
          </p>
        </div>
      </div>

      <!-- Horizontal, image-led filmstrip (MOMENTUM). Shares NO silhouette with a ledger. -->
      <div
        class="ad-strip"
        id="ad-strip"
        tabindex="0"
        role="group"
        aria-label="Service lanes — scroll horizontally through the filmstrip"
      >
        <ul class="ad-strip__track" role="list">
          {lanes.map((s) => (
            <li class="ad-frame">
              <figure class="ad-frame__fig">
                <div class="ad-frame__media">
                  <img
                    src={s.src}
                    width={s.w}
                    height={s.h}
                    alt={s.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="ad-frame__practical" aria-hidden="true"></span>
                  <div class="ad-frame__scrim" aria-hidden="true"></div>
                  <figcaption class="ad-frame__cap">
                    <span class="ad-frame__meta">{s.meta}</span>
                    <h3 class="ad-frame__t">{s.t}</h3>
                    <p class="ad-frame__d">{s.d}</p>
                  </figcaption>
                </div>
              </figure>
            </li>
          ))}
        </ul>
      </div>
      <div class="ad-shell">
        <p class="ad-strip__foot">
          <span class="ad-strip__hint" aria-hidden="true">
            Drag / scroll the strip &rarr;
          </span>
          <span class="ad-prov">
            Prototype reference imagery — direction, not After Hourz builds.
          </span>
        </p>
      </div>
    </section>

    <!-- ================= WORK · single-column reflection scroll ================= -->
    <section class="ad-work" id="work" aria-labelledby="work-h">
      <div class="ad-shell">
        <div class="ad-sechead ad-sechead--split">
          <div>
            <p class="ad-eyebrow">Work · the boulevard</p>
            <h2 class="ad-secttl" id="work-h">
              Out on the boulevard
            </h2>
          </div>
          <p class="ad-seclead">
            Southern California lowrider culture, one frame at a time — candy, gold wire wheels, low
            stance, read by found night light.
            <span class="ad-provclause">
              {' '}
              The images below are
              <strong> prototype reference</strong> — the direction, not After Hourz builds. Real
              work and process shots: <span class="ad-cir">Client input required</span>.
            </span>
          </p>
        </div>
      </div>

      <!-- Single column, hard negative space between frames -->
      <div class="ad-reflect">
        {reflections.map((r, i) => (
          <figure class={`ad-refl ad-refl--${r.ratio}`} data-reveal>
            <div class="ad-refl__media">
              <img
                src={r.src}
                width={r.w}
                height={r.h}
                alt={r.alt}
                loading="lazy"
                decoding="async"
              />
              <div class="ad-refl__pool" aria-hidden="true"></div>
            </div>
            <figcaption class="ad-refl__cap">
              <span class="ad-refl__idx" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="ad-refl__text">
                <span class="ad-refl__k">{r.k}</span>
                <span class="ad-refl__t">{r.t}</span>
                <p class="ad-refl__d">{r.d}</p>
                <span class="ad-prov">Prototype reference · stock · not client work</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ================= PROCESS · the night drive (flow line) ================= -->
    <section class="ad-process" id="process" aria-labelledby="proc-h">
      <div class="ad-shell">
        <div class="ad-sechead">
          <p class="ad-eyebrow">Process · the build</p>
          <h2 class="ad-secttl" id="proc-h">
            Strip → metal → candy → setup
          </h2>
          <p class="ad-seclead">
            A build moves in one direction, and there are no shortcuts to a clean lowrider. Four
            stops, one continuous line — it holds still if you prefer reduced motion.
          </p>
        </div>
      </div>

      <ol class="ad-drive" role="list">
        {process.map((p, i) => (
          <li class="ad-leg" data-reveal style={`--i:${i}`}>
            <span class="ad-leg__node" aria-hidden="true"></span>
            <span class="ad-leg__n">{p.n}</span>
            <h3 class="ad-leg__t">{p.t}</h3>
            <p class="ad-leg__d">{p.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ================= STORY ================= -->
    <section class="ad-story" id="story" aria-labelledby="story-h">
      <div class="ad-story__bg" aria-hidden="true"></div>
      <div class="ad-shell ad-story__grid">
        <div class="ad-story__copy" data-reveal>
          <p class="ad-eyebrow">The shop</p>
          <p class="ad-script ad-story__script">Built by hand</p>
          <h2 class="ad-secttl" id="story-h">
            Low, clean, and done right.
          </h2>
          <p class="ad-story__lead">
            After Hourz is Southern California lowrider work — body, paint, and restoration for
            people who care how the car sits and how the candy holds the light.
          </p>
          <p class="ad-story__p">
            The name is the method. When the lot clears and the world goes home, the real work
            starts: no rush, no audience, laying candy and gold-leaf until the paint has depth and
            the body line runs dead straight.
          </p>
          <p class="ad-story__note">
            <span class="ad-cir">Client input required</span> — owner bio, shop history, car club
            affiliation, and founding year. Nothing here is invented; the voice is a placeholder for
            Anthony&rsquo;s own words.
          </p>
        </div>

        <figure class="ad-story__fig" data-reveal="side">
          <div class="ad-story__media">
            <img
              src={`${P}/lowrider/impala-65-teal-krazyvatos-carclub-wall-01-S3aYtjE0YyI.jpg`}
              width="2400"
              height="1299"
              alt="A teal 1965 Impala lowrider beside its owner against a colorful mural wall — Southern California car-club culture, gold wire wheels and a low stance."
              loading="lazy"
              decoding="async"
            />
            <div class="ad-refl__pool" aria-hidden="true"></div>
          </div>
          <figcaption class="ad-story__figcap">
            Prototype reference · stock — not Anthony&rsquo;s shop or club. Real portraits:
            <span class="ad-cir">Client input required</span>.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ================= CONTACT / QUOTE ================= -->
    <section class="ad-contact" id="contact" aria-labelledby="contact-h">
      <div class="ad-contact__glow" aria-hidden="true"></div>
      <div class="ad-shell ad-contact__grid">
        <div class="ad-contact__intro">
          <p class="ad-eyebrow">Request a quote</p>
          <h2 class="ad-secttl" id="contact-h">
            Tell us what you&rsquo;re building.
          </h2>
          <p class="ad-contact__lead">
            We&rsquo;ll give you an honest read on the work — no pressure, no upsell.
          </p>

          <dl class="ad-channels ah-plaque">
            <div class="ad-channel">
              <dt>Phone</dt>
              <dd>
                <span class="ad-cir">Client input required</span>
              </dd>
            </div>
            <div class="ad-channel">
              <dt>Location</dt>
              <dd>
                Southern California{' '}
                <span class="ad-channel__sub">
                  (exact address — <span class="ad-cir">client input required</span>)
                </span>
              </dd>
            </div>
            <div class="ad-channel">
              <dt>Instagram</dt>
              <dd>
                <span class="ad-cir">Client input required</span>
              </dd>
            </div>
          </dl>
        </div>

        <form class="ad-form" id="ad-form" novalidate aria-labelledby="form-h">
          <p class="ad-form__h" id="form-h">
            Quote request
          </p>

          <div class="ad-field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="ad-field">
            <label for="f-vehicle">
              Vehicle <span class="ad-field__hint">Year · make · model</span>
            </label>
            <input id="f-vehicle" name="vehicle" type="text" autocomplete="off" required />
          </div>

          <div class="ad-field">
            <label for="f-service">Service</label>
            <div class="ad-select">
              <select id="f-service" name="service" required>
                <option value="" selected>
                  Choose a lane…
                </option>
                <option value="paint">Custom paint</option>
                <option value="body">Body work</option>
                <option value="restoration">Restoration</option>
                <option value="detail">Detail &amp; polish</option>
                <option value="other">Something else</option>
              </select>
              <span class="ad-select__arw" aria-hidden="true">
                &#9662;
              </span>
            </div>
          </div>

          <div class="ad-field">
            <label for="f-msg">What do you want done?</label>
            <textarea
              id="f-msg"
              name="message"
              rows="4"
              placeholder="Paint, bodywork, restoration — tell us the vision."
              required
            ></textarea>
          </div>

          <button class="ah-btn ah-btn--candy ad-form__submit" type="submit">
            Send request{' '}
            <span class="ad-arw" aria-hidden="true">
              &rarr;
            </span>
          </button>

          <p class="ad-form__ack" id="ad-form-ack" role="status" aria-live="polite" hidden>
            Prototype — this form isn&rsquo;t wired to a backend yet. Nothing was sent. Real
            submission handling: <span class="ad-cir">client input required</span>.
          </p>
          <p class="ad-form__fine">
            Prototype form · no data leaves your browser · no backend connected.
          </p>
        </form>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="ad-footer">
    <div class="ad-shell ad-footer__grid">
      <div class="ad-footer__brand">
        <BrandMark variant="wordmark" width={220} class="ad-brand ad-brand--foot" loading="lazy" />
        <p class="ad-footer__tag">Custom paint · body work · restoration — Southern California.</p>
      </div>

      <nav class="ad-footer__nav" aria-label="Footer">
        {navLinks.map(([href, label]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>

      <div class="ad-footer__meta">
        <p class="ad-footer__prov">
          Prototype — reference imagery, not client work. All photography is stock used to study the
          direction.
        </p>
        <p class="ad-footer__cir">
          Contact facts (phone · address · social · hours):
          <span class="ad-cir">Client input required</span>.
        </p>
        <a class="ad-footer__lab" href="/design-lab/">
          &larr; Design Lab
        </a>
      </div>
    </div>
  </footer>

  <!-- ================= STICKY MOBILE CONTACT BAR ================= -->
  <div class="ad-dock" aria-label="Quick contact">
    <a class="ad-dock__call" href="#contact">
      <span class="ad-dock__ico" aria-hidden="true">
        &#9990;
      </span>
      <span class="ad-dock__label">
        Call<span class="ad-dock__note">Client input required</span>
      </span>
    </a>
    <a class="ad-dock__quote ah-btn ah-btn--candy" href="#contact">
      Request a Quote
    </a>
  </div>

  <!-- ================= ISOLATED JS (menu · nav state · form) ================= -->
  <script>
    // Nav condensed state on scroll (progressive; class only, no layout dep)
    const nav = document.querySelector<HTMLElement>('.ad-nav');
    if (nav) {
      const onScroll = () => nav.setAttribute('data-scrolled', String(window.scrollY > 24));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Mobile menu — keyboard-operable, focus-managed, Escape closes, restores focus
    const btn = document.getElementById('ad-menu-btn');
    const menu = document.getElementById('ad-mobile-menu');
    if (btn && menu) {
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
        document.body.classList.toggle('ad-menu-open', open);
      };
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        setOpen(!open);
        if (!open) {
          const first = menu.querySelector<HTMLElement>('a');
          first?.focus();
        }
      });
      // Close on link tap + on Escape (restore focus to the toggle)
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          btn.focus();
        }
      });
    }

    // Prototype quote form — preventDefault + tasteful acknowledgement (no backend)
    const form = document.getElementById('ad-form') as HTMLFormElement | null;
    const ack = document.getElementById('ad-form-ack');
    if (form && ack) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        ack.hidden = false;
        ack.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    }
  </script>
</PrototypeLayout>
