---
import PrototypeLayout from '../../../../layouts/PrototypeLayout.astro';
import '../../../../styles/prototype-after-dark.css';

/*
  AFTER HOURZ — AFTER DARK · production-level direction prototype (Design Lab).
  Thesis: Southern California custom-car craftsmanship after sunset — warm sodium
  against a cool night, wet asphalt, culture, human energy. Motion = MOMENTUM.

  PROVENANCE / TRUTH RULES (non-negotiable):
  - Every external photo is PROTOTYPE REFERENCE — never Anthony's completed work.
    Each carries a visible "REFERENCE" affordance + a provenance line.
  - No fabricated business facts. Phone/address/social/hours = CLIENT INPUT REQUIRED.
  - Craft lane only: custom paint / body / restoration on classic + custom vehicles.
    The modern-supercar taillight frame is intentionally DROPPED.
  - SoCal only. No NorCal text/maps/badges.
*/

const P = '/assets/prototype';

// ---- Services (craft lanes — factual, no invented specifics) ----
const services = [
  {
    n: '01',
    t: 'Custom Paint',
    d: 'Color changes, candy and flake finishes, pinstripe and refinishing — laid down in patient layers until the reflection runs straight down the body line.',
    lane: 'Paint · candy · flake · pinstripe',
  },
  {
    n: '02',
    t: 'Body Work',
    d: 'Collision repair, rust and fabrication, panel alignment and gap-setting — the metal made true before a drop of color goes down.',
    lane: 'Collision · fabrication · panel',
  },
  {
    n: '03',
    t: 'Restoration',
    d: 'Classics and customs brought back and brought forward — cars, trucks, and bikes returned to the road with the details right.',
    lane: 'Classic · custom · frame-off',
  },
  {
    n: '04',
    t: 'Detail & Polish',
    d: 'Cut, buff, and finish work that makes the paint read like glass under one warm light — the last honest inch of a build.',
    lane: 'Cut · buff · protect',
  },
];

// ---- Work / builds — curated reference photography, focal hierarchy ----
// Lead = one dominant plate; the rest is a supporting rhythm. Craft lane only.
const lead = {
  src: `${P}/environment-dusk/black-sedan-station-canopy-wet-gloss-night-fngi9wSSpms.jpg`,
  w: 2400,
  h: 3593,
  alt: 'Black sedan under a service-station canopy at night, wet gloss paint and asphalt doubling the warm canopy light against the cool dark.',
  k: 'Gloss & reflection',
  t: 'Wet-night gloss study',
  d: 'How a finished panel behaves under one warm source against the cool dark — the reflection the shop chases.',
};

const builds = [
  {
    src: `${P}/chrome-heritage/green-lowrider-night-pinstripe-goldwheel-J3vo0W5buXc.jpg`,
    w: 2400,
    h: 3491,
    alt: 'Green lowrider at night with a gold wire-spoke wheel, whitewall tire, and teal pinstripe scrollwork along the body.',
    k: 'Lowrider culture',
    t: 'Gold wire & pinstripe',
    ratio: 'tall',
  },
  {
    src: `${P}/culture-vehicles/hands-polishing-black-hood-gloss-B7hVEFTFUWs.jpg`,
    w: 2400,
    h: 1600,
    alt: 'A pair of hands polishing a glossy black hood by hand, warm light raking across the wet-look finish.',
    k: 'The hand',
    t: 'Hand-finished gloss',
    ratio: 'wide',
  },
  {
    src: `${P}/chrome-heritage/lincoln-lowrider-gold-wire-wheel-indoor-intF_5yL1nk.jpg`,
    w: 2400,
    h: 4267,
    alt: 'Classic Lincoln lowrider indoors with a gold wire-spoke wheel and deep-gloss bodywork under directional light.',
    k: 'Restoration',
    t: 'Gold wire, restored',
    ratio: 'tall',
  },
  {
    src: `${P}/culture-vehicles/classic-chevy-c10-pickup-warm-dusk-6d1tDrPryEQ.jpg`,
    w: 2400,
    h: 1714,
    alt: 'Classic Chevrolet C10 pickup photographed in warm dusk light, body line catching the low sun.',
    k: 'Classic truck',
    t: 'C10 body-line study',
    ratio: 'wide',
  },
  {
    src: `${P}/culture-vehicles/stanced-car-deepdish-wheel-lowangle-W7dVzwCFCHs.jpg`,
    w: 2400,
    h: 3600,
    alt: 'Low-angle view of a stanced custom car on deep-dish wheels, tire and fender filling the frame.',
    k: 'Stance & wheel',
    t: 'Deep-dish, low angle',
    ratio: 'tall',
  },
  {
    src: `${P}/culture-vehicles/interior-steam-detail-backlit-silhouette-GaOk6CfdMVk.jpg`,
    w: 2400,
    h: 3598,
    alt: 'Backlit silhouette of an interior detail in progress, warm steam and light behind the work.',
    k: 'Interior detail',
    t: 'Backlit detail work',
    ratio: 'tall',
  },
];

// ---- Process arc — momentum: strip → metal → color → cut/buff ----
const process = [
  {
    n: '01',
    t: 'Strip & assess',
    d: 'An honest read on the metal. What is real, what is filler, what has to be cut out and rebuilt.',
  },
  {
    n: '02',
    t: 'Metal & body',
    d: 'Panels aligned, gaps set, primer blocked flat. The finish only ever shows what is underneath.',
  },
  {
    n: '03',
    t: 'Base · candy · clear',
    d: 'Color goes down in patient layers — base, candy, flake, clear — until the depth is real, not painted on.',
  },
  {
    n: '04',
    t: 'Cut & buff',
    d: 'Sanded flat and buffed back up so the reflection runs straight down the body line. Then it rolls out.',
  },
];
---

<PrototypeLayout
  title="After Hourz — After Dark"
  description="After Dark design direction for After Hourz: Southern California custom-car craftsmanship after sunset. Design Lab prototype — reference imagery, not client work."
  bodyClass="ad"
>
  <!-- Lab chrome — subtle return affordance (suppressed later in client-review mode) -->
  <div class="ad-lab">
    <div class="ad-shell ad-lab__row">
      <span class="ad-lab__tag">Design Lab · Prototype · After Dark · not client-approved</span>
      <a class="ad-lab__back" href="/design-lab/">
        <span aria-hidden="true">&larr;</span> Design Lab
      </a>
    </div>
  </div>

  <!-- ================= NAV ================= -->
  <header class="ad-nav" id="top" data-scrolled="false">
    <div class="ad-shell ad-nav__row">
      <a class="ad-wordmark" href="#top" aria-label="After Hourz — home">
        AFTER<span class="ad-wordmark__z">HOUR<b>Z</b></span>
      </a>

      <nav class="ad-nav__links" aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#process">Process</a>
        <a href="#services">Services</a>
        <a href="#story">Story</a>
        <a href="#contact">Contact</a>
      </nav>

      <a class="ad-btn ad-btn--sodium ad-nav__cta" href="#contact">Request a Quote</a>

      <button
        class="ad-menu-btn"
        id="ad-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="ad-mobile-menu"
      >
        <span class="ad-menu-btn__bars" aria-hidden="true"></span>
        <span class="ad-sr">Menu</span>
      </button>
    </div>

    <!-- Mobile menu (keyboard-operable; JS-enhanced, focus-managed) -->
    <div class="ad-mobile" id="ad-mobile-menu" hidden>
      <nav class="ad-mobile__nav" aria-label="Mobile">
        <a href="#work">Work</a>
        <a href="#process">Process</a>
        <a href="#services">Services</a>
        <a href="#story">Story</a>
        <a href="#contact">Contact</a>
        <a class="ad-btn ad-btn--sodium ad-mobile__cta" href="#contact">Request a Quote</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ================= HERO ================= -->
    <section class="ad-hero" aria-labelledby="hero-h">
      <div class="ad-hero__media">
        <img
          class="ad-hero__img"
          src={`${P}/environment-dusk/vintage-truck-foggy-gas-station-night-o2GgDamhkQA.jpg`}
          width="2400"
          height="4267"
          alt="Vintage truck parked at a foggy gas station at night — a warm sodium canopy glows over cool fog, and wet asphalt doubles the light."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="ad-hero__grade" aria-hidden="true"></div>
        <div class="ad-hero__halo" aria-hidden="true"></div>
      </div>

      <span class="ad-refbadge ad-hero__ref">Reference</span>

      <div class="ad-shell ad-hero__inner">
        <div class="ad-hero__panel" data-reveal>
          <p class="ad-eyebrow">Southern California · after dark</p>
          <h1 class="ad-hero__h1" id="hero-h">
            Built in the<br /><span class="ad-hero__warm">hours after</span>
          </h1>
          <p class="ad-hero__kicker">
            Custom paint · body work · restoration — Southern California
          </p>
          <p class="ad-hero__sub">
            Cars, trucks, and bikes finished the way the West Coast builds them: patient,
            hand-worked, and worth the drive across town at night.
          </p>
          <div class="ad-hero__actions">
            <a class="ad-btn ad-btn--sodium ad-btn--lg" href="#contact">
              Request a Quote <span class="ad-arw" aria-hidden="true">&rarr;</span>
            </a>
            <a class="ad-btn ad-btn--ghost ad-btn--lg" href="#work">See the work</a>
          </div>
        </div>
      </div>

      <p class="ad-hero__prov">Prototype reference imagery — not a real After Hourz build.</p>
    </section>

    <!-- ================= SERVICES ================= -->
    <section class="ad-services" id="services" aria-labelledby="svc-h">
      <div class="ad-shell">
        <div class="ad-sechead">
          <p class="ad-eyebrow">Services</p>
          <h2 class="ad-secttl" id="svc-h">The craft lanes</h2>
          <p class="ad-seclead">
            Four things done properly, not everything done fast. Every build runs the same
            honest arc — metal true first, color last.
          </p>
        </div>

        <ul class="ad-svc-list" role="list">
          {services.map((s) => (
            <li class="ad-svc" data-reveal>
              <span class="ad-svc__n">{s.n}</span>
              <div class="ad-svc__body">
                <h3 class="ad-svc__t">{s.t}</h3>
                <p class="ad-svc__d">{s.d}</p>
                <span class="ad-svc__lane">{s.lane}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ================= WORK / BUILDS ================= -->
    <section class="ad-work" id="work" aria-labelledby="work-h">
      <div class="ad-shell">
        <div class="ad-sechead ad-sechead--split">
          <div>
            <p class="ad-eyebrow">Work · reference set</p>
            <h2 class="ad-secttl" id="work-h">The night has a look</h2>
          </div>
          <p class="ad-seclead">
            Warm against cool, wet asphalt, one honest light. The images below are
            <strong>prototype reference</strong> — the direction, not After Hourz builds.
            Real work and process shots: <span class="ad-cir">Client input required</span>.
          </p>
        </div>

        <!-- Lead plate — the dominant work image -->
        <figure class="ad-lead" data-reveal>
          <div class="ad-lead__media">
            <img
              src={lead.src}
              width={lead.w}
              height={lead.h}
              alt={lead.alt}
              loading="lazy"
              decoding="async"
            />
            <span class="ad-refbadge">Reference</span>
          </div>
          <figcaption class="ad-lead__cap">
            <span class="ad-lead__k">{lead.k}</span>
            <span class="ad-lead__t">{lead.t}</span>
            <p class="ad-lead__d">{lead.d}</p>
            <span class="ad-prov">Prototype reference · stock · not client work</span>
          </figcaption>
        </figure>

        <!-- Supporting rhythm — consistent crop logic, single ratio family -->
        <ul class="ad-builds" role="list">
          {builds.map((b) => (
            <li class={`ad-build ad-build--${b.ratio}`} data-reveal>
              <figure>
                <div class="ad-build__media">
                  <img
                    src={b.src}
                    width={b.w}
                    height={b.h}
                    alt={b.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="ad-refbadge ad-refbadge--sm">Reference</span>
                  <div class="ad-build__scrim" aria-hidden="true"></div>
                </div>
                <figcaption class="ad-build__cap">
                  <span class="ad-build__k">{b.k}</span>
                  <span class="ad-build__t">{b.t}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ================= PROCESS (momentum rail) ================= -->
    <section class="ad-process" id="process" aria-labelledby="proc-h">
      <div class="ad-shell">
        <div class="ad-sechead">
          <p class="ad-eyebrow">Process · momentum</p>
          <h2 class="ad-secttl" id="proc-h">Strip → metal → color → cut</h2>
          <p class="ad-seclead">
            The build moves in one direction. Drag or scroll the rail — it pauses when you
            reach for it, and holds still if you prefer reduced motion.
          </p>
        </div>
      </div>

      <div
        class="ad-rail"
        id="ad-rail"
        tabindex="0"
        role="group"
        aria-label="Process steps — scroll horizontally"
      >
        <ol class="ad-rail__track" role="list">
          {process.map((p) => (
            <li class="ad-step">
              <span class="ad-step__n">{p.n}</span>
              <h3 class="ad-step__t">{p.t}</h3>
              <p class="ad-step__d">{p.d}</p>
              <span class="ad-step__bar" aria-hidden="true"></span>
            </li>
          ))}
        </ol>
      </div>
      <div class="ad-shell">
        <p class="ad-rail__hint" aria-hidden="true">Drag / scroll the rail &rarr;</p>
      </div>
    </section>

    <!-- ================= STORY ================= -->
    <section class="ad-story" id="story" aria-labelledby="story-h">
      <div class="ad-story__bg" aria-hidden="true"></div>
      <div class="ad-shell ad-story__grid">
        <div class="ad-story__copy" data-reveal>
          <p class="ad-eyebrow">The shop</p>
          <h2 class="ad-secttl" id="story-h">The finish speaks. The copy stays quiet.</h2>
          <p class="ad-story__lead">
            After Hourz is Southern California custom-car work — body, paint, and
            restoration for people who care how the light runs down a panel.
          </p>
          <p class="ad-story__p">
            The name is the method. When the lot clears and the world goes home, the real
            work starts: no rush, no audience, one warm light on the metal until the
            reflection is straight and the gaps are right.
          </p>
          <p class="ad-story__note">
            <span class="ad-cir">Client input required</span> — owner bio, shop history, and
            founding year. Nothing here is invented; the voice is a placeholder for
            Anthony&rsquo;s own words.
          </p>
        </div>

        <figure class="ad-story__fig" data-reveal="side">
          <div class="ad-story__media">
            <img
              src={`${P}/culture-vehicles/mechanic-under-car-lowangle-craft-jL9zfzTVSwY.jpg`}
              width="2400"
              height="3600"
              alt="Low-angle craft portrait: a person works beneath a raised vehicle in a workshop, looking up at the underbody."
              loading="lazy"
              decoding="async"
            />
            <span class="ad-refbadge ad-refbadge--sm">Reference</span>
          </div>
          <figcaption class="ad-story__figcap">
            Prototype reference · stock — not Anthony. Real portraits:
            <span class="ad-cir">Client input required</span>.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ================= CONTACT / QUOTE ================= -->
    <section class="ad-contact" id="contact" aria-labelledby="contact-h">
      <div class="ad-contact__glow" aria-hidden="true"></div>
      <div class="ad-shell ad-contact__grid">
        <div class="ad-contact__intro">
          <p class="ad-eyebrow">Request a quote</p>
          <h2 class="ad-secttl" id="contact-h">Tell us what you&rsquo;re building.</h2>
          <p class="ad-contact__lead">
            We&rsquo;ll give you an honest read on the work — no pressure, no upsell.
          </p>

          <dl class="ad-channels">
            <div class="ad-channel">
              <dt>Phone</dt>
              <dd><span class="ad-cir">Client input required</span></dd>
            </div>
            <div class="ad-channel">
              <dt>Location</dt>
              <dd>Southern California <span class="ad-channel__sub">(exact address — <span class="ad-cir">client input required</span>)</span></dd>
            </div>
            <div class="ad-channel">
              <dt>Instagram</dt>
              <dd><span class="ad-cir">Client input required</span></dd>
            </div>
          </dl>
        </div>

        <form class="ad-form" id="ad-form" novalidate aria-labelledby="form-h">
          <p class="ad-form__h" id="form-h">Quote request</p>

          <div class="ad-field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="ad-field">
            <label for="f-vehicle">Vehicle</label>
            <input
              id="f-vehicle"
              name="vehicle"
              type="text"
              placeholder="Year · make · model"
              autocomplete="off"
              required
            />
          </div>

          <div class="ad-field">
            <label for="f-service">Service</label>
            <div class="ad-select">
              <select id="f-service" name="service" required>
                <option value="" selected>Choose a lane…</option>
                <option value="paint">Custom paint</option>
                <option value="body">Body work</option>
                <option value="restoration">Restoration</option>
                <option value="detail">Detail &amp; polish</option>
                <option value="other">Something else</option>
              </select>
              <span class="ad-select__arw" aria-hidden="true">&#9662;</span>
            </div>
          </div>

          <div class="ad-field">
            <label for="f-msg">What do you want done?</label>
            <textarea
              id="f-msg"
              name="message"
              rows="4"
              placeholder="Paint, bodywork, restoration — tell us the vision."
              required></textarea>
          </div>

          <button class="ad-btn ad-btn--sodium ad-btn--block" type="submit">
            Send request <span class="ad-arw" aria-hidden="true">&rarr;</span>
          </button>

          <p class="ad-form__ack" id="ad-form-ack" role="status" aria-live="polite" hidden>
            Prototype — this form isn&rsquo;t wired to a backend yet. Nothing was sent.
            Real submission handling: <span class="ad-cir">client input required</span>.
          </p>
          <p class="ad-form__fine">
            Prototype form · no data leaves your browser · no backend connected.
          </p>
        </form>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="ad-footer">
    <div class="ad-shell ad-footer__grid">
      <div class="ad-footer__brand">
        <span class="ad-wordmark ad-wordmark--foot">AFTER<span class="ad-wordmark__z">HOUR<b>Z</b></span></span>
        <p class="ad-footer__tag">
          Custom paint · body work · restoration — Southern California.
        </p>
      </div>

      <nav class="ad-footer__nav" aria-label="Footer">
        <a href="#work">Work</a>
        <a href="#process">Process</a>
        <a href="#services">Services</a>
        <a href="#story">Story</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="ad-footer__meta">
        <p class="ad-footer__prov">
          Prototype — reference imagery, not client work. All photography is stock used to
          study the direction.
        </p>
        <p class="ad-footer__cir">
          Contact facts (phone · address · social · hours):
          <span class="ad-cir">Client input required</span>.
        </p>
        <a class="ad-footer__lab" href="/design-lab/">&larr; Design Lab</a>
      </div>
    </div>
  </footer>

  <!-- ================= STICKY MOBILE CONTACT BAR ================= -->
  <div class="ad-dock" aria-label="Quick contact">
    <a class="ad-dock__call" href="#contact">
      <span class="ad-dock__ico" aria-hidden="true">&#9990;</span> Call
      <span class="ad-dock__note">CLIENT INPUT REQUIRED</span>
    </a>
    <a class="ad-dock__quote ad-btn ad-btn--sodium" href="#contact">Request a Quote</a>
  </div>

  <!-- ================= ISOLATED JS (menu · nav state · form) ================= -->
  <script>
    // Nav condensed state on scroll (progressive; class only, no layout dep)
    const nav = document.querySelector<HTMLElement>('.ad-nav');
    if (nav) {
      const onScroll = () =>
        nav.setAttribute('data-scrolled', String(window.scrollY > 24));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Mobile menu — keyboard-operable, focus-managed, Escape closes, restores focus
    const btn = document.getElementById('ad-menu-btn');
    const menu = document.getElementById('ad-mobile-menu');
    if (btn && menu) {
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
        document.body.classList.toggle('ad-menu-open', open);
      };
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        setOpen(!open);
        if (!open) {
          const first = menu.querySelector<HTMLElement>('a');
          first?.focus();
        }
      });
      // Close on link tap + on Escape (restore focus to the toggle)
      menu.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => setOpen(false)),
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          btn.focus();
        }
      });
    }

    // Prototype quote form — preventDefault + tasteful acknowledgement (no backend)
    const form = document.getElementById('ad-form') as HTMLFormElement | null;
    const ack = document.getElementById('ad-form-ack');
    if (form && ack) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        ack.hidden = false;
        ack.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    }
  </script>
</PrototypeLayout>
