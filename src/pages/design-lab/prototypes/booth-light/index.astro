---
/*
  PROTOTYPE — BOOTH LIGHT  (production-level direction study · REBUILT on the LOCKED brand)
  Route: /design-lab/prototypes/booth-light   ·   Body class: .bl-proto
  (design-lab only; NOT production)

  ONE brand, three editions. This edition is the STUDIO / MACRO / SURFACE / PRECISION
  reading of After Hourz: craft revealed through CONTROLLED INSPECTION LIGHT on paint
  and surface. It shares the LOCKED family with Chrome Heritage + After Dark — black
  ground, chrome edges, cobalt/electric-blue accent, the real client chrome wordmark
  (BrandMark) — but composes them differently: a near-black inspection studio where a
  single raking light reveals high-gloss cobalt clearcoat and chrome trim.

  This REPLACES the prior HIGH-KEY WHITE version, which read as a light-mode SaaS site
  and drifted off the black/chrome/cobalt brand.

  NON-NEGOTIABLE guardrails honored:
   - Southern California framing only. NO NorCal marks / maps / QUINCY / NorCal badge.
   - Every external photo is PROTOTYPE / REFERENCE material — affordance shown, never
     presented as Anthony's completed work. Hero included.
   - Unknown business facts (phone / address / social / hours / pricing) are OMITTED or
     marked CLIENT INPUT REQUIRED — never fabricated.
   - All routes under /design-lab/*. No production routes.
*/
import PrototypeLayout from '../../../../layouts/PrototypeLayout.astro';
import BrandMark from '../../../../components/brand/BrandMark.astro';
import '../../../../styles/prototype-booth-light.css';

const P = '/assets/prototype';
const BB = `${P}/blue-booth`;

// --- Primary nav (anchors must resolve to real section ids) ---
const nav = [
  ['Work', '#work'],
  ['Process', '#process'],
  ['Services', '#services'],
  ['Story', '#story'],
  ['Contact', '#contact'],
];

// --- SERVICES: one lead lane + a stacked precise list (NOT 3 equal cards) ---
const serviceList = [
  [
    '02',
    'Body work',
    'Collision, rust and panel fabrication — the true structure a finish is only as good as.',
  ],
  [
    '03',
    'Restoration',
    'Classic and custom vehicles brought back true — metal, trim and finish, together.',
  ],
  [
    '04',
    'Detail & polish',
    'Cut, buff and correction until the reflection runs flat and the light reads clean.',
  ],
];

// --- WORK gallery: one dominant frame + a supporting rhythm. Each is REFERENCE. ---
const work = [
  {
    cls: 'bl-fig--lead',
    src: `${BB}/bluepaint-6_Rv_qzog90.jpg`,
    w: 2400,
    h: 4265,
    pos: '52% 42%',
    alt: 'Curved high-gloss cobalt body panel meeting a run of bright chrome window trim, both catching a single directional light against near-black reflections.',
    title: 'Panel & chrome',
    note: 'Where finish depth meets a chrome edge — the surface reading true.',
  },
  {
    cls: 'bl-fig--tall',
    src: `${BB}/metallic-BY59EiUXxuw.jpg`,
    w: 2400,
    h: 3600,
    pos: '50% 46%',
    alt: 'Cobalt metallic hood and headlight under a soft top highlight, cool gloss resolving into dark accents.',
    title: 'Cobalt gloss',
    note: 'Metallic depth under a controlled key.',
  },
  {
    cls: 'bl-fig--half',
    src: `${BB}/clearcoat-dSBsnAKTAi8.jpg`,
    w: 2400,
    h: 2400,
    pos: '50% 50%',
    alt: 'Macro of a headlight and cobalt clearcoat beaded with water under cool, controlled inspection light.',
    title: 'Clearcoat, beaded',
    note: 'Precise reflection on a fresh clear.',
  },
  {
    cls: 'bl-fig--half',
    src: `${BB}/polish-B7hVEFTFUWs.jpg`,
    w: 2400,
    h: 1600,
    pos: '50% 42%',
    alt: 'Dual-action buffer polishing a dark car near a lit headlight strip inside a detailing bay on a near-black ground.',
    title: 'Cut & buff',
    note: 'The reflection run flat — precision made visible.',
  },
  {
    cls: 'bl-fig--third',
    src: `${BB}/bluepaint-IqPGeGbBROY.jpg`,
    w: 2400,
    h: 1200,
    pos: '50% 50%',
    alt: 'Macro of deep blue metallic clearcoat with a single water bead and a raking specular streak against near-black shadow.',
    title: 'Metalflake',
    note: 'A single raking streak proves the flake.',
  },
  {
    cls: 'bl-fig--third',
    src: `${BB}/clearcoat-dveDkZQJVjQ.jpg`,
    w: 2400,
    h: 3600,
    pos: '50% 40%',
    alt: 'Moody cobalt rear panel and taillight emerging from a dark surround, cinematic and cool in tone.',
    title: 'Rear panel',
    note: 'Gloss emerging from darkness.',
  },
  {
    cls: 'bl-fig--third',
    src: `${BB}/chrome-v8H6bnjmths.jpg`,
    w: 2400,
    h: 3600,
    pos: '50% 50%',
    alt: 'Dark side mirror and glossy body panel emerging from shadow with cool blue-black reflections and a chrome edge catching light.',
    title: 'Chrome edge',
    note: 'One lit edge out of shadow.',
  },
];

// --- PROCESS: the application -> inspection arc ---
const process = [
  ['01', 'Strip & assess', 'An honest read on the metal before anything else is decided.', 'Read'],
  [
    '02',
    'Metal & bodywork',
    'Panels made true, gaps set — the base every reflection needs.',
    'True',
  ],
  [
    '03',
    'Base · color · clear',
    'Depth built in patient coats under a controlled booth key.',
    'Build',
  ],
  [
    '04',
    'Inspection reveal',
    'Read under one raking light until the reflection runs flat.',
    'Expose',
  ],
];
---

<PrototypeLayout
  title="After Hourz — Booth Light"
  description="Booth Light design direction for After Hourz: craft revealed through controlled inspection light on high-gloss cobalt and chrome. Concept prototype — reference imagery, not client work."
  bodyClass="bl-proto"
>
  <!-- LAB CHROME · subtle Design-Lab return (suppressed in client-review mode) -->
  <div class="bl-labstrip">
    <div class="bl-wrap bl-labstrip__row">
      <span>
        Design Lab · Prototype · <b>Booth Light</b> · direction study, not client-approved
      </span>
      <span>
        <a href="/design-lab/">&larr; Design Lab</a>
      </span>
    </div>
  </div>

  <!-- NAV — real chrome wordmark + links + filled cobalt Quote + mobile menu -->
  <header class="bl-nav" data-scrolled="false" data-menu="closed" id="top">
    <div class="bl-wrap bl-nav__row">
      <a class="bl-logo" href="#top" aria-label="After Hourz — home">
        <BrandMark variant="wordmark" width={168} small={true} loading="eager" alt="After Hourz" />
      </a>
      <nav class="bl-nav__links" aria-label="Primary">
        {nav.map(([label, href]) => (
          <a class="bl-nav__link" href={href}>
            {label}
          </a>
        ))}
      </nav>
      <div class="bl-nav__end">
        <a class="bl-btn bl-btn--primary" href="#contact">
          Request a Quote
        </a>
        <button
          type="button"
          class="bl-burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="bl-mobilemenu"
          data-menu-toggle
        >
          <span class="bl-burger__bar" aria-hidden="true"></span>
          <span class="bl-burger__bar" aria-hidden="true"></span>
          <span class="bl-burger__bar" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </header>
  <!-- Mobile menu panel (sibling of nav; CSS reveals on [data-menu='open']) -->
  <div class="bl-mobilemenu" id="bl-mobilemenu">
    <div class="bl-wrap bl-mobilemenu__inner">
      {nav.map(([label, href], i) => (
        <a class="bl-mobilemenu__link" href={href} data-menu-link>
          {label}
          <span>{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))}
      <a class="bl-btn bl-btn--primary" href="#contact" data-menu-link>
        Request a Quote
      </a>
    </div>
  </div>

  <main id="main">
    <!-- ================= HERO — photography-first ================= -->
    <!-- The cobalt supercar body sits low-right in near-black; type lives in the
         large dark negative space top-left, as the frame was composed for. -->
    <section class="bl-hero" aria-labelledby="hero-h">
      <img
        class="bl-hero__img"
        src={`${BB}/clearcoat-_0eOyLYXIto.jpg`}
        width="2400"
        height="1600"
        alt="A cobalt-blue supercar body emerging from a near-black studio, a single raking rim-light tracing the panel edges."
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="bl-hero__grade" aria-hidden="true"></div>
      <span class="bl-hero__rake" aria-hidden="true"></span>
      <span class="bl-stamp bl-stamp--hero">Reference imagery</span>

      <div class="bl-wrap bl-hero__inner">
        <div class="bl-hero__content">
          <BrandMark
            variant="lockup"
            width={360}
            class="bl-hero__lockup"
            alt="After Hourz — by Anthony Montoya"
            loading="eager"
            fetchpriority="high"
          />
          <p class="bl-hero__kicker">
            Custom paint · body work · restoration · Southern California
          </p>
          <h1 id="hero-h" class="bl-hero__h1">
            The finish only shows
            <br />
            what&rsquo;s <em>underneath.</em>
          </h1>
          <p class="bl-hero__sub">
            Built patiently in the booth, then read under a single controlled inspection light —
            high-gloss cobalt, a clean chrome edge, a reflection that runs flat.
          </p>
          <div class="bl-hero__actions">
            <a class="bl-btn bl-btn--primary bl-btn--lg" href="#contact">
              Request a Quote
              <span class="bl-btn__arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
            <a class="bl-btn bl-btn--onink bl-btn--lg" href="#work">
              See the work
            </a>
          </div>
        </div>
      </div>

      <!-- Scope readout: a mono spec plate that reads as an inspection ticket. -->
      <div class="bl-hero__readout" aria-label="Shop scope">
        <div class="bl-wrap bl-hero__readout-row">
          <span>
            <b>Custom paint</b>colour &amp; refinish
          </span>
          <span>
            <b>Body work</b>metal &amp; panel
          </span>
          <span>
            <b>Restoration</b>classic &amp; custom
          </span>
          <span class="bl-hero__readout-region">
            <b>SoCal</b>service area
          </span>
        </div>
      </div>
    </section>

    <!-- ================= WORK / BUILDS ================= -->
    <section class="bl-section" id="work" aria-labelledby="work-h">
      <div class="bl-wrap">
        <div class="bl-shead" data-bl-reveal>
          <span class="bl-shead__no">Work</span>
          <h2 id="work-h" class="bl-shead__title">
            Read the surface
          </h2>
          <p class="bl-shead__lead">
            A visual study of the craft — high-gloss cobalt, chrome edges and the macro details that
            decide whether a finish is real. Every frame below is external reference for this
            direction, not After Hourz&rsquo;s completed work.
          </p>
        </div>

        <!-- ONE provenance caption for the whole block (not a badge per tile). -->
        <p class="bl-provline" data-bl-reveal>
          <span class="bl-provline__dot" aria-hidden="true"></span>
          Reference imagery — external, chosen to argue this direction. Not After Hourz&rsquo;s
          completed work.
        </p>

        <div class="bl-work" data-bl-reveal>
          {work.map((f) => (
            <figure class={`bl-fig ${f.cls}`}>
              <div class="bl-fig__frame">
                <img
                  src={f.src}
                  width={f.w}
                  height={f.h}
                  alt={f.alt}
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${f.pos};`}
                />
              </div>
              <figcaption>
                <span class="bl-fig__cap-title">{f.title}</span>
                <span class="bl-fig__cap-note">{f.note}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= INSPECTION REVEAL · the dramatic beat ================= -->
    <!-- The whole page lives in one dark studio; this is where the single
         inspection light is turned up and the reveal becomes the payoff. -->
    <section class="bl-reveal" aria-labelledby="reveal-h" data-bl-reveal data-bl-expose>
      <div class="bl-reveal__grid">
        <div class="bl-reveal__copy">
          <p class="bl-reveal__kicker">The inspection reveal</p>
          <h2 id="reveal-h" class="bl-reveal__h2">
            One light.
            <br />
            The whole <em>truth.</em>
          </h2>
          <p class="bl-reveal__p">
            A single raking light runs the body line, and every wave, every high spot, every honest
            coat shows itself. If it survives this, it survives daylight.
          </p>
          <div class="bl-reveal__spec">
            <span>
              <b>1</b>raking light
            </span>
            <span>
              <b>0</b>places to hide
            </span>
            <span>
              <b>Flat</b>reflection or it goes back
            </span>
          </div>
        </div>
        <div class="bl-reveal__media">
          <img
            src={`${P}/materials-detail/near-black-body-line-study-fBjCurUh-9w.jpg`}
            width="2400"
            height="4266"
            alt="A single specular highlight traces the body line of a near-black painted panel in near-total darkness."
            loading="lazy"
            decoding="async"
          />
          <span class="bl-reveal__light" aria-hidden="true"></span>
          <span class="bl-reveal__seam" aria-hidden="true"></span>
          <BrandMark
            variant="wordmark-mono"
            width={200}
            class="bl-reveal__mark"
            alt="After Hourz"
            loading="lazy"
          />
          <span class="bl-stamp">Reference imagery</span>
        </div>
      </div>
    </section>

    <!-- ================= PROCESS ================= -->
    <section class="bl-section bl-section--process" id="process" aria-labelledby="process-h">
      <div class="bl-wrap">
        <div class="bl-shead" data-bl-reveal>
          <span class="bl-shead__no">Process</span>
          <h2 id="process-h" class="bl-shead__title">
            Application, then inspection
          </h2>
          <p class="bl-shead__lead">
            The arc runs one way: from a controlled booth key to a single-light inspection. Nothing
            ships until the last light reads clean.
          </p>
        </div>

        <div class="bl-process-rail" data-bl-reveal>
          {process.map(([no, title, body, meta]) => (
            <article class="bl-pstep">
              <span class="bl-pstep__no">STATION {no}</span>
              <h3 class="bl-pstep__title">{title}</h3>
              <p class="bl-pstep__body">{body}</p>
              <span class="bl-pstep__meta">{meta}</span>
            </article>
          ))}
        </div>

        <div data-bl-reveal>
          <div class="bl-arcbar" aria-hidden="true"></div>
          <div class="bl-arclabels">
            <span>Controlled booth key</span>
            <span>Single-light inspection</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= SERVICES ================= -->
    <section class="bl-section" id="services" aria-labelledby="services-h">
      <div class="bl-wrap">
        <div class="bl-shead" data-bl-reveal>
          <span class="bl-shead__no">Services</span>
          <h2 id="services-h" class="bl-shead__title">
            The craft lanes
          </h2>
          <p class="bl-shead__lead">
            Four things, done with the same patience. The paint is what you see; the work underneath
            is what makes it last.
          </p>
        </div>

        <div class="bl-services" data-bl-reveal>
          <!-- Lead lane: custom paint, with a real reference frame -->
          <article class="bl-service-lead">
            <div class="bl-service-lead__media">
              <img
                src={`${BB}/clearcoat-G6sI_6B_FFY.jpg`}
                width="2400"
                height="1600"
                alt="Gloved hands peeling protective blue film off a freshly finished cobalt panel under cool workshop light."
                loading="lazy"
                decoding="async"
              />
              <span class="bl-stamp">Reference imagery</span>
            </div>
            <div class="bl-service-lead__body">
              <span class="bl-service-lead__no">01</span>
              <h3>Custom paint</h3>
              <p>
                Colour changes, factory-correct refinishing and custom finishes — flake, candy and
                clear built in coats, then cut back until the depth reads true under light.
              </p>
              <a class="bl-textlink" href="#contact">
                Start a paint quote &rarr;
              </a>
            </div>
          </article>

          <!-- Supporting list -->
          <div class="bl-service-list">
            {serviceList.map(([no, title, body]) => (
              <div class="bl-service-item">
                <span class="bl-service-item__no">{no}</span>
                <div class="bl-service-item__body">
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ================= STORY ================= -->
    <section class="bl-section bl-section--story" id="story" aria-labelledby="story-h">
      <div class="bl-wrap">
        <div class="bl-story" data-bl-reveal>
          <div class="bl-story__media">
            <img
              src={`${P}/culture-vehicles/craftsman-polisher-dark-portrait-M5lsL2E4ot0.jpg`}
              width="2400"
              height="3200"
              alt="A craftsman working a polisher in low light, concentrated on the panel in front of them."
              loading="lazy"
              decoding="async"
            />
            <span class="bl-stamp">Reference imagery</span>
          </div>
          <div class="bl-story__body">
            <span class="bl-story__region">Southern California raised</span>
            <blockquote class="bl-story__quote" id="story-h">
              After Hourz is where the <em>extra hours</em> go — the ones that turn a repair into a
              finish worth looking at twice.
            </blockquote>
            <p class="bl-story__p">
              Owned by Anthony Montoya, After Hourz is built on patience: metal made true, gaps set
              right, and paint laid in coats that earn their depth. The name is the promise — the
              work that happens after the easy version is finished.
            </p>
            <p class="bl-story__p bl-story__p--cir">
              This is a direction study. The shop&rsquo;s full story, its builds and its people are
              <b> CLIENT INPUT REQUIRED</b> and will replace the reference imagery shown here.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT · prototype quote form ================= -->
    <section class="bl-contact" id="contact" aria-labelledby="contact-h">
      <div class="bl-wrap bl-section">
        <div class="bl-contact__grid">
          <div class="bl-contact__aside" data-bl-reveal>
            <span class="bl-shead__no">Contact</span>
            <h2 id="contact-h" class="bl-contact__title">
              Request a quote
            </h2>
            <p class="bl-contact__p">
              Tell us about the vehicle and what you want done. No pressure, no upsell — just an
              honest read on the work and where to start.
            </p>
            <dl class="bl-contact__facts">
              <div class="bl-contact__fact">
                <dt>Phone</dt>
                <dd>
                  <span class="bl-contact__req">Client input required</span>
                </dd>
              </div>
              <div class="bl-contact__fact">
                <dt>Email</dt>
                <dd>
                  <span class="bl-contact__req">Client input required</span>
                </dd>
              </div>
              <div class="bl-contact__fact">
                <dt>Instagram</dt>
                <dd>
                  <span class="bl-contact__req">Client input required</span>
                </dd>
              </div>
              <div class="bl-contact__fact">
                <dt>Service area</dt>
                <dd class="bl-contact__region-fact">Southern California</dd>
              </div>
            </dl>
          </div>

          <!-- Prototype form: preventDefault + tasteful acknowledgement. No backend. -->
          <form class="bl-form" data-bl-reveal aria-labelledby="form-h" data-quote-form novalidate>
            <h3 id="form-h" class="bl-spec bl-form__title">
              Quote request — prototype
            </h3>
            <div class="bl-form__grid">
              <div class="bl-field">
                <label for="q-name">
                  Your name{' '}
                  <span class="bl-req" aria-hidden="true">
                    *
                  </span>
                </label>
                <input
                  id="q-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  placeholder="Your name"
                />
              </div>
              <div class="bl-field">
                <label for="q-vehicle">
                  Vehicle{' '}
                  <span class="bl-req" aria-hidden="true">
                    *
                  </span>
                </label>
                <input
                  id="q-vehicle"
                  name="vehicle"
                  type="text"
                  required
                  placeholder="Year · make · model"
                />
              </div>
              <div class="bl-field bl-field--full">
                <label for="q-service">Service</label>
                <select id="q-service" name="service">
                  <option value="">Choose a service</option>
                  <option value="custom-paint">Custom paint</option>
                  <option value="body-work">Body work</option>
                  <option value="restoration">Restoration</option>
                  <option value="detail-polish">Detail &amp; polish</option>
                  <option value="not-sure">Not sure yet</option>
                </select>
              </div>
              <div class="bl-field bl-field--full">
                <label for="q-msg">What do you want done?</label>
                <textarea
                  id="q-msg"
                  name="message"
                  placeholder="Paint, bodywork, restoration — tell us the goal."
                ></textarea>
              </div>
            </div>
            <div class="bl-form__foot">
              <button class="bl-btn bl-btn--primary" type="submit">
                Request a Quote
                <span class="bl-btn__arrow" aria-hidden="true">
                  &rarr;
                </span>
              </button>
              <p class="bl-form__note">Prototype form — not wired to a backend.</p>
            </div>
            <p class="bl-form__ack" role="status" aria-live="polite" data-quote-ack>
              Thanks — this is a prototype, so nothing was sent. On the live site this would reach
              After Hourz directly.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="bl-footer">
    <div class="bl-wrap">
      <div class="bl-footer__top">
        <div class="bl-footer__brandcol">
          <BrandMark
            variant="wordmark"
            width={220}
            class="bl-footer__mark"
            alt="After Hourz"
            loading="lazy"
          />
          <p class="bl-footer__tag">
            Custom paint, body work and restoration — Southern California. Craft revealed through
            controlled inspection light.
          </p>
        </div>
        <nav class="bl-footer__nav" aria-label="Footer">
          {nav.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
          <a href="/design-lab/">Design Lab</a>
        </nav>
      </div>
      <div class="bl-footer__bottom">
        <span class="bl-footer__prov">Prototype — reference imagery, not client work</span>
        <span class="bl-footer__cir">Contact details · CLIENT INPUT REQUIRED · Not deployed</span>
      </div>
    </div>
  </footer>

  <!-- STICKY MOBILE CONTACT BAR · thumb zone. No fabricated phone number. -->
  <div class="bl-cta-bar" aria-label="Quick contact">
    <a class="bl-cta-bar__link bl-cta-bar__link--call" href="#contact">
      <span class="bl-cta-bar__ico" aria-hidden="true">
        &#9990;
      </span>
      Callback
    </a>
    <a class="bl-cta-bar__link bl-cta-bar__link--quote" href="#contact">
      <span class="bl-cta-bar__ico" aria-hidden="true">
        &rarr;
      </span>
      Request a Quote
    </a>
  </div>

  <!-- Small, isolated, reduced-motion-safe JS: nav scroll state, mobile menu,
       exposure reveal, prototype form. -->
  <script>
    // --- Nav scrolled state (shadow) ---
    const navEl = document.querySelector<HTMLElement>('.bl-nav');
    if (navEl) {
      const setScrolled = () => navEl.setAttribute('data-scrolled', String(window.scrollY > 24));
      setScrolled();
      window.addEventListener('scroll', setScrolled, { passive: true });
    }

    // --- Mobile menu (keyboard-operable; Escape closes; focus restored) ---
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (navEl && toggle) {
      const open = () => {
        navEl.setAttribute('data-menu', 'open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
      };
      const close = (restore = true) => {
        navEl.setAttribute('data-menu', 'closed');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        if (restore) toggle.focus();
      };
      toggle.addEventListener('click', () => {
        if (navEl.getAttribute('data-menu') === 'open') close();
        else open();
      });
      document
        .querySelectorAll<HTMLElement>('[data-menu-link]')
        .forEach((l) => l.addEventListener('click', () => close(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && navEl.getAttribute('data-menu') === 'open') close();
      });
    }

    // --- Exposure reveal (opacity/rise). Additive + fail-open: content is never
    //     left hidden by JS. Anything already in/above the viewport reveals at
    //     once; the rest reveal on scroll; a safety timer reveals everything so a
    //     stalled observer can never hide primary content. ---
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revEls = Array.from(document.querySelectorAll<HTMLElement>('[data-bl-reveal]'));
    const revealAll = () => revEls.forEach((el) => el.classList.add('is-revealed'));
    if (reduce || !('IntersectionObserver' in window)) {
      revealAll();
    } else {
      const reveal = (el: Element) => el.classList.add('is-revealed');
      const vh = window.innerHeight;
      revEls.forEach((el) => {
        if (el.getBoundingClientRect().top < vh * 0.92) reveal(el);
      });
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              reveal(e.target);
              obs.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0 },
      );
      revEls.forEach((el) => {
        if (!el.classList.contains('is-revealed')) io.observe(el);
      });
      window.setTimeout(revealAll, 2600);
    }

    // --- Prototype quote form: preventDefault + acknowledgement ---
    const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
    const ack = document.querySelector<HTMLElement>('[data-quote-ack]');
    if (form && ack) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        ack.setAttribute('data-shown', 'true');
        ack.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      });
    }
  </script>
</PrototypeLayout>
