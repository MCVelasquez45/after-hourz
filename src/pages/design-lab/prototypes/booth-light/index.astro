  <!-- Small, isolated, reduced-motion-safe JS: nav scroll state, mobile menu,
       exposure reveal, prototype form. -->
  <script>
    // --- Nav scrolled state (shadow) ---
    const navEl = document.querySelector<HTMLElement>('.bl-nav');
    if (navEl) {
      const setScrolled = () =>
        navEl.setAttribute('data-scrolled', String(window.scrollY > 24));
      setScrolled();
      window.addEventListener('scroll', setScrolled, { passive: true });
    }

    // --- Mobile menu (keyboard-operable; Escape closes; focus restored) ---
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (navEl && toggle) {
      const open = () => {
        navEl.setAttribute('data-menu', 'open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
      };
      const close = (restore = true) => {
        navEl.setAttribute('data-menu', 'closed');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        if (restore) toggle.focus();
      };
      toggle.addEventListener('click', () => {
        if (navEl.getAttribute('data-menu') === 'open') close();
        else open();
      });
      document.querySelectorAll<HTMLElement>('[data-menu-link]').forEach((l) =>
        l.addEventListener('click', () => close(false)),
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && navEl.getAttribute('data-menu') === 'open') close();
      });
    }

    // --- Exposure reveal (opacity/rise). Additive + fail-open: content is never
    //     left hidden by JS. Anything already in/above the viewport reveals at
    //     once; the rest reveal on scroll; a safety timer reveals everything so a
    //     stalled observer can never hide primary content. ---
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revEls = Array.from(document.querySelectorAll<HTMLElement>('[data-bl-reveal]'));
    const revealAll = () => revEls.forEach((el) => el.classList.add('is-revealed'));
    if (reduce || !('IntersectionObserver' in window)) {
      revealAll();
    } else {
      const reveal = (el: Element) => el.classList.add('is-revealed');
      // Reveal what's already visible on load (top of page / large sections).
      const vh = window.innerHeight;
      revEls.forEach((el) => {
        if (el.getBoundingClientRect().top < vh * 0.92) reveal(el);
      });
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              reveal(e.target);
              obs.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0 },
      );
      revEls.forEach((el) => {
        if (!el.classList.contains('is-revealed')) io.observe(el);
      });
      // Fail-open: never let the exposure motion keep content hidden.
      window.setTimeout(revealAll, 2600);
    }

    // --- Prototype quote form: preventDefault + acknowledgement ---
    const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
    const ack = document.querySelector<HTMLElement>('[data-quote-ack]');
    if (form && ack) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        ack.setAttribute('data-shown', 'true');
        ack.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      });
    }
  </script>
</PrototypeLayout>
