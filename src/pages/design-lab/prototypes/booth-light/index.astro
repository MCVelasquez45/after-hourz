---
/*
  PROTOTYPE — BOOTH LIGHT  (production-level direction study)
  Route: /design-lab/prototypes/booth-light   (design-lab only; NOT production)

  This REPLACES the rejected baseline (which read as a light-mode SaaS docs site
  and failed the gate swap test). Rebuilt to the art-direction board at
  /design-lab/directions/booth-light and surpassing it as a full website.

  Provenance discipline (P8): every photograph is EXTERNAL PROTOTYPE reference,
  badged "Reference", never presented as Anthony's completed work. Business facts
  (phone / address / social / hours) are OMITTED or marked CLIENT INPUT REQUIRED
  — never fabricated. Anthony is Southern California raised: no NorCal text/maps/
  badges, no "QUINCY" mural, no Northern-California geography.
*/
import PrototypeLayout from '../../../../layouts/PrototypeLayout.astro';
import '../../../../styles/prototype-booth-light.css';

const P = '/assets/prototype';

// --- Primary nav ---
const nav = [
  ['Work', '#work'],
  ['Process', '#process'],
  ['Services', '#services'],
  ['Story', '#story'],
  ['Contact', '#contact'],
];

// --- Services: one lead lane + a stacked precise list (not 3 equal cards) ---
const serviceList = [
  [
    '01',
    'Body work',
    'Collision, rust and panel fabrication — the true structure a finish is only as good as.',
  ],
  [
    '02',
    'Custom paint',
    'Colour changes, factory-correct refinishing and custom work, built in patient coats.',
  ],
  [
    '03',
    'Restoration',
    'Classic and custom vehicles brought back true — metal, trim and finish, together.',
  ],
  [
    '04',
    'Detail & polish',
    'Cut, buff and correction until the reflection runs flat and the light reads clean.',
  ],
];

// --- WORK gallery: dominant lead + supporting rhythm. Each is REFERENCE. ---
const work = [
  {
    cls: 'bl-fig--lead',
    src: `${P}/booth-process/painter-respirator-blue-bumper-booth-uGeatFJ81xw.jpg`,
    w: 2400,
    h: 3000,
    alt: 'Painter in a respirator laying blue basecoat across a bumper inside a brightly lit spray booth.',
    title: 'In the booth',
    note: 'Basecoat under a controlled cool key — the application half of the arc.',
  },
  {
    cls: 'bl-fig--tall',
    src: `${P}/materials-detail/copper-gloss-body-panel-chrome-trim-cPN7dnQRyiY.jpg`,
    w: 2400,
    h: 1600,
    alt: 'Deep copper-gloss body panel meeting a run of polished chrome trim, both catching directional light.',
    title: 'Gloss & trim',
    note: 'Where finish depth meets chrome — the surface reading true.',
  },
  {
    cls: 'bl-fig--half',
    src: `${P}/booth-process/spray-gun-clearcoat-glossy-panel-macro-hXhbEFS48oM.jpg`,
    w: 2400,
    h: 1965,
    alt: 'Close macro of a spray gun laying wet clearcoat across a glossy panel.',
    title: 'Clearcoat, wet',
    note: 'The moment finish depth is built.',
  },
  {
    cls: 'bl-fig--half',
    src: `${P}/booth-process/dual-action-polisher-blue-fender-Gu17tebrrV8.jpg`,
    w: 2400,
    h: 1349,
    alt: 'Dual-action polisher working a blue fender to a flat, even reflection.',
    title: 'Cut & buff',
    note: 'The reflection run flat — precision made visible.',
  },
  {
    cls: 'bl-fig--third',
    src: `${P}/booth-process/bare-metal-classic-body-restoration-cD7nA_pqj6E.jpg`,
    w: 2400,
    h: 1603,
    alt: 'Bare-metal classic body panel mid-restoration under even workshop light.',
    title: 'Bare metal',
    note: 'Honest metal before anything is hidden.',
  },
  {
    cls: 'bl-fig--third',
    src: `${P}/materials-detail/blue-metalflake-clearcoat-waterbead-IqPGeGbBROY.jpg`,
    w: 2400,
    h: 1200,
    alt: 'Water beading on blue metalflake clearcoat, flake catching a single directional light.',
    title: 'Metalflake',
    note: 'Beadwork and flake — proof of a real finish.',
  },
  {
    cls: 'bl-fig--third',
    src: `${P}/booth-process/spray-gun-blue-basecoat-masking-macro-vfQqwENtjDU.jpg`,
    w: 2400,
    h: 1600,
    alt: 'Spray gun applying blue basecoat along a crisply masked edge with green masking tape.',
    title: 'The masked line',
    note: 'A crisp taped edge — control at the boundary.',
  },
