    <div class="bl-wrap bl-labstrip__row">
      <span>Design Lab · Prototype · <b>Booth Light</b> · direction study, not client-approved</span>
      <span><a href="/design-lab/">&larr; Design Lab</a></span>
    </div>
  </div>

  <!-- NAV -->
