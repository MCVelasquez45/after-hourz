---
/*
  PROTOTYPE — BOOTH LIGHT  (production-level direction study · REBUILT on the LOCKED brand)
  Route: /design-lab/prototypes/booth-light   ·   Body class: .bl-proto
  (design-lab only; NOT production)

  ONE brand, three editions. This edition is the STUDIO / MACRO / SURFACE / PRECISION
  reading of After Hourz: craft revealed through CONTROLLED INSPECTION LIGHT on paint
  and surface. It shares the LOCKED family with Chrome Heritage + After Dark — black
  ground, chrome edges, cobalt/electric-blue accent, the real client chrome wordmark
  (BrandMark) — but composes them differently: a near-black inspection studio where a
  single raking light reveals high-gloss cobalt clearcoat and chrome trim.

  This REPLACES the prior HIGH-KEY WHITE version, which read as a light-mode SaaS site
  and drifted off the black/chrome/cobalt brand.

  NON-NEGOTIABLE guardrails honored:
   - Southern California framing only. NO NorCal marks / maps / QUINCY / NorCal badge.
   - Every external photo is PROTOTYPE / REFERENCE material — affordance shown, never
     presented as Anthony's completed work. Hero included.
   - Unknown business facts (phone / address / social / hours / pricing) are OMITTED or
     marked CLIENT INPUT REQUIRED — never fabricated.
   - All routes under /design-lab/*. No production routes.
*/
import PrototypeLayout from '../../../../layouts/PrototypeLayout.astro';
import BrandMark from '../../../../components/brand/BrandMark.astro';
import '../../../../styles/prototype-booth-light.css';

const P = '/assets/prototype';
const LR = `${P}/lowrider`;

// --- Primary nav (anchors must resolve to real section ids) ---
const nav = [
  ['Work', '#work'],
  ['Process', '#process'],
  ['Services', '#services'],
  ['Story', '#story'],
  ['Contact', '#contact'],
];

// --- SERVICES: one lead lane + a stacked precise list (NOT 3 equal cards) ---
const serviceList = [
  [
    '02',
    'Body & metal work',
    'Collision, rust and panel fabrication — the straight metal a candy job is only as good as.',
  ],
  [
    '03',
    'Restoration',
    'Impalas, Regals, Cutlasses and Lincolns brought back true — metal, chrome and candy together.',
  ],
  [
    '04',
    'Chrome, wire & detail',
    'Gold-and-chrome wire wheels, engraving and cut-and-buff until the candy reads deep and clean.',
  ],
];

// --- WORK gallery: the CANDY-FINISH study. How a lowrider earns its candy —
//     gold-leaf, pinstripe, candy under light, wire-wheel + chrome detail.
//     One dominant frame + a supporting rhythm. Each is external REFERENCE. ---
const work = [
  {
    cls: 'bl-fig--lead',
    src: `${LR}/candy-orange-metalflake-goldleaf-hood-macro-01-33Me56HyM_8.jpg`,
    w: 2400,
    h: 3600,
    pos: '50% 44%',
    alt: 'Macro of a candy-orange metalflake hood with hand-laid gold-leaf scrollwork and fine pinstripe catching a single raking light.',
    title: 'Gold-leaf & candy',
    note: 'Hand-laid gold-leaf over candy metalflake — the finish that reads twice.',
  },
  {
    cls: 'bl-fig--tall',
    src: `${LR}/candy-metalflake-pinstripe-goldleaf-macro-01-PTxSbnFA2aE.jpg`,
    w: 2400,
    h: 3600,
    pos: '50% 46%',
    alt: 'Candy metalflake panel with pinstripe and gold-leaf scrollwork, flake sparkling under a controlled key light.',
    title: 'Metalflake, lit',
    note: 'A single key turns the flake to sparks.',
  },
  {
    cls: 'bl-fig--half',
    src: `${LR}/goldwheel-chrome-whitewall-sunflare-macro-01-obYxajIGaVs.jpg`,
    w: 2400,
    h: 3622,
    pos: '50% 50%',
    alt: 'Sunlit gold-and-chrome wire-spoke wheel with a whitewall tire, specular star-flares off the spokes.',
    title: 'Gold wire, chrome',
    note: 'Gold-and-chrome wire spokes — the lowrider signature.',
  },
  {
    cls: 'bl-fig--half',
    src: `${LR}/lincoln-candy-red-pinstripe-side-murals-01-8ZrI15afLCk.jpg`,
    w: 2400,
    h: 1600,
    pos: '50% 46%',
    alt: 'Candy-red Lincoln body panel with fine pinstripe and gold-leaf side murals under warm directional light.',
    title: 'Pinstripe & mural',
    note: 'Pinstripe and gold-leaf murals laid straight by hand.',
  },
  {
    cls: 'bl-fig--third',
    src: `${LR}/goldwheel-engraved-whitewall-yellowcandy-macro-01-4Xhi09hdwDE.jpg`,
    w: 2400,
    h: 1600,
    pos: '50% 50%',
    alt: 'Engraved chrome wire wheel and whitewall against candy-yellow metalflake, one raking streak across the flake.',
    title: 'Engraved chrome',
    note: 'Engraved knock-off, whitewall, candy behind.',
  },
  {
    cls: 'bl-fig--third',
    src: `${LR}/impala-blue-candy-chromewheel-pinstripe-01-y-Ye8UI6a5U.jpg`,
    w: 2400,
    h: 1600,
    pos: '50% 50%',
    alt: 'Candy-cobalt Impala side with chrome wire wheel and purple pinstripe murals, low stance in SoCal light.',
    title: 'Candy cobalt',
    note: 'Candy cobalt on chrome wire, purple pinstripe.',
  },
  {
    cls: 'bl-fig--third',
    src: `${LR}/impala-chrome-emblem-macro-candy-01-VNdZyGjd0ko.jpg`,
    w: 2400,
    h: 1597,
    pos: '50% 50%',
    alt: 'Chrome Impala emblem macro sitting proud on deep candy paint, one lit chrome edge out of shadow.',
    title: 'Chrome emblem',
    note: 'One lit chrome edge on deep candy.',
  },
];

// --- PROCESS: the application -> inspection arc ---
const process = [
  [
    '01',
    'Strip & straighten',
    'Metal made true and gaps set — no candy hides a bad panel.',
    'True',
  ],
  [
    '02',
    'Base · metalflake',
    'Ground coats and flake laid even, so the candy has something to burn on.',
    'Flake',
  ],
  [
    '03',
    'Candy · gold-leaf · stripe',
    'Candy built in coats, gold-leaf and pinstripe laid by hand.',
    'Lay it',
  ],
  [
    '04',
    'Clear · cut · buff',
    'Buried in clear, then cut back till the candy runs wet and deep.',
    'Wet',
  ],
];
---

<PrototypeLayout
  title="After Hourz — Booth Light"
  description="Booth Light design direction for After Hourz: the candy-finish lowrider edition — candy over metalflake, gold-leaf and pinstripe, gold-and-chrome wire wheels, read under one light. Concept prototype — reference imagery, not client work."
  bodyClass="bl-proto"
>
  <!-- LAB CHROME · subtle Design-Lab return (suppressed in client-review mode) -->
  <div class="bl-labstrip">
    <div class="bl-wrap bl-labstrip__row">
      <span>
        Design Lab · Prototype · <b>Booth Light</b> · direction study, not client-approved
      </span>
      <span>
        <a href="/design-lab/">&larr; Design Lab</a>
      </span>
    </div>
  </div>

  <!-- NAV — real chrome wordmark + links + filled cobalt Quote + mobile menu -->
  <header class="bl-nav" data-scrolled="false" data-menu="closed" id="top">
    <div class="bl-wrap bl-nav__row">
      <a class="bl-logo" href="#top" aria-label="After Hourz — home">
        <BrandMark variant="wordmark" width={168} small={true} loading="eager" alt="After Hourz" />
      </a>
      <nav class="bl-nav__links" aria-label="Primary">
        {nav.map(([label, href]) => (
          <a class="bl-nav__link" href={href}>
            {label}
          </a>
        ))}
      </nav>
      <div class="bl-nav__end">
        <a class="ah-btn ah-btn--candy bl-nav__cta" href="#contact">
          Request a Quote
        </a>
        <button
          type="button"
          class="bl-burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="bl-mobilemenu"
          data-menu-toggle
        >
          <span class="bl-burger__bar" aria-hidden="true"></span>
          <span class="bl-burger__bar" aria-hidden="true"></span>
          <span class="bl-burger__bar" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </header>
  <!-- Mobile menu panel (sibling of nav; CSS reveals on [data-menu='open']) -->
  <div class="bl-mobilemenu" id="bl-mobilemenu">
    <div class="bl-wrap bl-mobilemenu__inner">
      {nav.map(([label, href], i) => (
        <a class="bl-mobilemenu__link" href={href} data-menu-link>
          {label}
          <span>{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))}
      <a class="ah-btn ah-btn--candy bl-mobilemenu__cta" href="#contact" data-menu-link>
        Request a Quote
      </a>
    </div>
  </div>

  <main id="main">
    <!-- ================= HERO — photography-first ================= -->
    <!-- The cobalt supercar body sits low-right in near-black; type lives in the
         large dark negative space top-left, as the frame was composed for. -->
    <section class="bl-hero" aria-labelledby="hero-h">
      <img
        class="bl-hero__img"
        src={`${LR}/goldwheel-chrome-red-convertible-lowangle-01-Oq8G_2134uk.jpg`}
        width="2400"
        height="3600"
        alt="Low-angle close-up of a candy-red lowrider's rear quarter and a chrome-and-gold wire-spoke wheel with knock-off and whitewall, deep candy paint holding a clean reflection at golden hour."
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="bl-hero__grade" aria-hidden="true"></div>
      <span class="bl-hero__rake" aria-hidden="true"></span>
      <span class="bl-stamp bl-stamp--hero">Reference imagery</span>

      <div class="bl-wrap bl-hero__inner">
        <div class="bl-hero__content">
          <BrandMark
            variant="lockup"
            width={360}
            class="bl-hero__lockup"
            alt="After Hourz — by Anthony Montoya"
            loading="eager"
            fetchpriority="high"
          />
          <p class="bl-hero__kicker">
            <span class="ah-tuscan">Candy · Gold-leaf · Pinstripe</span> · Southern California
          </p>
          <p class="bl-hero__script ah-script">Laid on right, under the light.</p>
          <h1 id="hero-h" class="bl-hero__h1">
            Candy that shows
            <br />
            what&rsquo;s <em>underneath.</em>
          </h1>
          <p class="bl-hero__sub">
            Built in coats and read under one controlled light — candy over metalflake, gold-leaf
            laid by hand, pinstripe straight, chrome and gold wire wheels that never quit.
          </p>
          <div class="bl-hero__actions">
            <a class="ah-btn ah-btn--candy bl-hero__cta" href="#contact">
              Request a Quote
            </a>
            <a class="ah-btn ah-btn--ghost" href="#work">
              See the work
            </a>
          </div>
        </div>
      </div>

      <!-- Scope readout: a mono spec plate that reads as an inspection ticket. -->
      <div class="bl-hero__readout" aria-label="Shop scope">
        <div class="bl-wrap bl-hero__readout-row">
          <span>
            <b>Candy paint</b>flake &amp; refinish
          </span>
          <span>
            <b>Gold-leaf</b>leaf &amp; pinstripe
          </span>
          <span>
            <b>Chrome &amp; wire</b>wheels &amp; trim
          </span>
          <span class="bl-hero__readout-region">
            <b>SoCal</b>service area
          </span>
        </div>
      </div>
    </section>

    <!-- ================= WORK / BUILDS ================= -->
    <section class="bl-section" id="work" aria-labelledby="work-h">
      <div class="bl-wrap">
        <div class="bl-shead" data-bl-reveal>
          <span class="bl-shead__no">Work</span>
          <p class="bl-shead__script ah-script">Candy, gold-leaf &amp; wire</p>
          <h2 id="work-h" class="bl-shead__title">
            How the candy gets made
          </h2>
          <p class="bl-shead__lead">
            A study of the finish — candy over metalflake, gold-leaf and pinstripe laid by hand,
            gold-and-chrome wire wheels under a single key. Every frame below is external reference
            for this direction, not After Hourz&rsquo;s completed work.
          </p>
        </div>

        <!-- ONE provenance caption for the whole block (not a badge per tile). -->
        <p class="bl-provline" data-bl-reveal>
          <span class="bl-provline__dot" aria-hidden="true"></span>
          Reference imagery — external, chosen to argue this direction. Not After Hourz&rsquo;s
          completed work.
        </p>

        <div class="bl-work" data-bl-reveal>
          {work.map((f) => (
            <figure class={`bl-fig ${f.cls}`}>
              <div class="bl-fig__frame">
                <img
                  src={f.src}
                  width={f.w}
                  height={f.h}
                  alt={f.alt}
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${f.pos};`}
                />
              </div>
              <figcaption>
                <span class="bl-fig__cap-title">{f.title}</span>
                <span class="bl-fig__cap-note">{f.note}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= INSPECTION REVEAL · the dramatic beat ================= -->
    <!-- The whole page lives in one dark studio; this is where the single
         inspection light is turned up and the reveal becomes the payoff. -->
    <section class="bl-reveal" aria-labelledby="reveal-h" data-bl-reveal data-bl-expose>
      <div class="bl-reveal__grid">
        <div class="bl-reveal__copy">
          <p class="bl-reveal__kicker">The candy reveal</p>
          <p class="bl-reveal__script ah-script">Wet, deep &amp; dead straight</p>
          <h2 id="reveal-h" class="bl-reveal__h2">
            One light.
            <br />
            The candy <em>talks.</em>
          </h2>
          <p class="bl-reveal__p">
            A single light runs the panel and the candy goes deep — flake lighting up like sparks,
            gold-leaf catching, pinstripe dead straight. If it reads here, it reads on the
            boulevard.
          </p>
          <div class="bl-reveal__spec">
            <span>
              <b>1</b>raking light
            </span>
            <span>
              <b>&infin;</b>coats of depth
            </span>
            <span>
              <b>Flake</b>lit up like sparks
            </span>
          </div>
        </div>
        <div class="bl-reveal__media">
          <img
            src={`${LR}/candy-orange-metalflake-goldleaf-hood-macro-01-33Me56HyM_8.jpg`}
            width="2400"
            height="3600"
            alt="A single raking light crosses a candy-orange metalflake hood, gold-leaf scrollwork and pinstripe lighting up out of deep shadow."
            loading="lazy"
            decoding="async"
          />
          <span class="bl-reveal__light" aria-hidden="true"></span>
          <span class="bl-reveal__seam" aria-hidden="true"></span>
          <BrandMark
            variant="wordmark-mono"
            width={200}
            class="bl-reveal__mark"
            alt="After Hourz"
            loading="lazy"
          />
          <span class="bl-stamp">Reference imagery</span>
        </div>
      </div>
    </section>

    <!-- ================= PROCESS ================= -->
    <section class="bl-section bl-section--process" id="process" aria-labelledby="process-h">
      <div class="bl-wrap">
        <hr class="ah-pinstripe bl-pinstripe" aria-hidden="true" />
        <div class="bl-shead" data-bl-reveal>
          <span class="bl-shead__no">Process</span>
          <p class="bl-shead__script ah-script">From bare metal to candy</p>
          <h2 id="process-h" class="bl-shead__title">
            Coats, leaf &amp; clear
          </h2>
          <p class="bl-shead__lead">
            The arc runs one way: straight metal, flake, candy, gold-leaf and pinstripe, then buried
            in clear and cut back. Nothing rolls out until the candy runs deep.
          </p>
        </div>

        <div class="bl-process-rail" data-bl-reveal>
          {process.map(([no, title, body, meta]) => (
            <article class="bl-pstep">
              <span class="bl-pstep__no">STATION {no}</span>
              <h3 class="bl-pstep__title">{title}</h3>
              <p class="bl-pstep__body">{body}</p>
              <span class="bl-pstep__meta">{meta}</span>
            </article>
          ))}
        </div>

        <div data-bl-reveal>
          <div class="bl-arcbar" aria-hidden="true"></div>
          <div class="bl-arclabels">
            <span>Bare metal</span>
            <span>Wet candy under the light</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= SERVICES ================= -->
    <section class="bl-section" id="services" aria-labelledby="services-h">
      <div class="bl-wrap">
        <hr class="ah-pinstripe bl-pinstripe" aria-hidden="true" />
        <div class="bl-shead" data-bl-reveal>
          <span class="bl-shead__no">Services</span>
          <p class="bl-shead__script ah-script">What the shop lays down</p>
          <h2 id="services-h" class="bl-shead__title">
            The craft lanes
          </h2>
          <p class="bl-shead__lead">
            Four things, done with the same patience. The candy is what you see; the straight metal
            and the hand-work underneath are what make it last.
          </p>
        </div>

        <div class="bl-services" data-bl-reveal>
          <!-- Lead lane: custom paint, with a real reference frame -->
          <article class="bl-service-lead ah-plaque">
            <div class="bl-service-lead__media">
              <img
                src={`${LR}/lincoln-candy-red-goldleaf-hood-mural-01-80Izckypu88.jpg`}
                width="2400"
                height="1600"
                alt="A candy-red Lincoln hood with hand-laid gold-leaf mural and pinstripe under warm directional light."
                loading="lazy"
                decoding="async"
              />
              <span class="bl-stamp">Reference imagery</span>
            </div>
            <div class="bl-service-lead__body">
              <span class="bl-service-lead__no">01</span>
              <h3>Custom candy &amp; gold-leaf</h3>
              <p>
                Colour changes, candy and metalflake, gold-leaf and pinstripe — built in coats, laid
                by hand, then buried in clear and cut back till the candy runs wet and deep.
              </p>
              <a class="bl-textlink" href="#contact">
                Start a paint quote &rarr;
              </a>
            </div>
          </article>

          <!-- Supporting list -->
          <div class="bl-service-list">
            {serviceList.map(([no, title, body]) => (
              <div class="bl-service-item">
                <span class="bl-service-item__no">{no}</span>
                <div class="bl-service-item__body">
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ================= STORY ================= -->
    <section class="bl-section bl-section--story" id="story" aria-labelledby="story-h">
      <div class="bl-wrap">
        <div class="bl-story" data-bl-reveal>
          <div class="bl-story__media ah-plaque">
            <img
              src={`${LR}/impala-63-black-dusk-goldwheels-sunset-01-wxYh-8OMPO4.jpg`}
              width="2400"
              height="3611"
              alt="A black 1963 Impala lowrider on gold wire-spoke wheels sitting low against a pink Southern California sunset."
              loading="lazy"
              decoding="async"
            />
            <span class="bl-stamp">Reference imagery</span>
          </div>
          <div class="bl-story__body">
            <span class="bl-story__region">Southern California raised</span>
            <p class="bl-story__script ah-script">Firme, from the frame up</p>
            <blockquote class="bl-story__quote" id="story-h">
              After Hourz is where the <em>extra hours</em> go — the ones that turn a build into
              candy worth looking at twice.
            </blockquote>
            <p class="bl-story__p">
              Owned by Anthony Montoya, After Hourz is built on patience: metal made true, gaps set
              right, candy and gold-leaf laid in coats that earn their depth. The name is the
              promise — the work that happens after the easy version is finished.
            </p>
            <p class="bl-story__p bl-story__p--cir">
              This is a direction study. The shop&rsquo;s full story, its builds and its people are
              <b> CLIENT INPUT REQUIRED</b> and will replace the reference imagery shown here.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT · prototype quote form ================= -->
    <section class="bl-contact" id="contact" aria-labelledby="contact-h">
      <div class="bl-wrap bl-section">
        <div class="bl-contact__grid">
          <div class="bl-contact__aside" data-bl-reveal>
            <span class="bl-shead__no">Contact</span>
            <p class="bl-shead__script ah-script">Bring us the ride</p>
            <h2 id="contact-h" class="bl-contact__title">
              Request a quote
            </h2>
            <p class="bl-contact__p">
              Tell us about the vehicle and what you want done. No pressure, no upsell — just an
              honest read on the work and where to start.
            </p>
            <dl class="bl-contact__facts">
              <div class="bl-contact__fact">
                <dt>Phone</dt>
                <dd>
                  <span class="bl-contact__req">Client input required</span>
                </dd>
              </div>
              <div class="bl-contact__fact">
                <dt>Email</dt>
                <dd>
                  <span class="bl-contact__req">Client input required</span>
                </dd>
              </div>
              <div class="bl-contact__fact">
                <dt>Instagram</dt>
                <dd>
                  <span class="bl-contact__req">Client input required</span>
                </dd>
              </div>
              <div class="bl-contact__fact">
                <dt>Service area</dt>
                <dd class="bl-contact__region-fact">Southern California</dd>
              </div>
            </dl>
          </div>

          <!-- Prototype form: preventDefault + tasteful acknowledgement. No backend. -->
          <form class="bl-form" data-bl-reveal aria-labelledby="form-h" data-quote-form novalidate>
            <h3 id="form-h" class="bl-spec bl-form__title">
              Quote request — prototype
            </h3>
            <div class="bl-form__grid">
              <div class="bl-field">
                <label for="q-name">
                  Your name{' '}
                  <span class="bl-req" aria-hidden="true">
                    *
                  </span>
                </label>
                <input
                  id="q-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  placeholder="Your name"
                />
              </div>
              <div class="bl-field">
                <label for="q-vehicle">
                  Vehicle{' '}
                  <span class="bl-req" aria-hidden="true">
                    *
                  </span>
                </label>
                <input
                  id="q-vehicle"
                  name="vehicle"
                  type="text"
                  required
                  placeholder="Year · make · model"
                />
              </div>
              <div class="bl-field bl-field--full">
                <label for="q-service">Service</label>
                <select id="q-service" name="service">
                  <option value="">Choose a service</option>
                  <option value="custom-paint">Custom paint</option>
                  <option value="body-work">Body work</option>
                  <option value="restoration">Restoration</option>
                  <option value="detail-polish">Detail &amp; polish</option>
                  <option value="not-sure">Not sure yet</option>
                </select>
              </div>
              <div class="bl-field bl-field--full">
                <label for="q-msg">What do you want done?</label>
                <textarea
                  id="q-msg"
                  name="message"
                  placeholder="Paint, bodywork, restoration — tell us the goal."
                ></textarea>
              </div>
            </div>
            <div class="bl-form__foot">
              <button class="ah-btn ah-btn--candy" type="submit">
                Request a Quote
              </button>
              <p class="bl-form__note">Prototype form — not wired to a backend.</p>
            </div>
            <p class="bl-form__ack" role="status" aria-live="polite" data-quote-ack>
              Thanks — this is a prototype, so nothing was sent. On the live site this would reach
              After Hourz directly.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="bl-footer">
    <div class="bl-wrap">
      <div class="bl-footer__top">
        <div class="bl-footer__brandcol">
          <BrandMark
            variant="wordmark"
            width={220}
            class="bl-footer__mark"
            alt="After Hourz"
            loading="lazy"
          />
          <p class="bl-footer__tag">
            Custom candy, gold-leaf, body work and restoration — Southern California. Lowrider
            craft, laid on right and read under the light.
          </p>
        </div>
        <nav class="bl-footer__nav" aria-label="Footer">
          {nav.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
          <a href="/design-lab/">Design Lab</a>
        </nav>
      </div>
      <div class="bl-footer__bottom">
        <span class="bl-footer__prov">Prototype — reference imagery, not client work</span>
        <span class="bl-footer__cir">Contact details · CLIENT INPUT REQUIRED · Not deployed</span>
      </div>
    </div>
  </footer>

  <!-- STICKY MOBILE CONTACT BAR · thumb zone. No fabricated phone number. -->
  <div class="bl-cta-bar" aria-label="Quick contact">
    <a class="ah-btn ah-btn--chrome bl-cta-bar__link bl-cta-bar__link--call" href="#contact">
      Callback
    </a>
    <a class="ah-btn ah-btn--candy bl-cta-bar__link bl-cta-bar__link--quote" href="#contact">
      Request a Quote
    </a>
  </div>

  <!-- Small, isolated, reduced-motion-safe JS: nav scroll state, mobile menu,
       exposure reveal, prototype form. -->
  <script>
    // --- Nav scrolled state (shadow) ---
    const navEl = document.querySelector<HTMLElement>('.bl-nav');
    if (navEl) {
      const setScrolled = () => navEl.setAttribute('data-scrolled', String(window.scrollY > 24));
      setScrolled();
      window.addEventListener('scroll', setScrolled, { passive: true });
    }

    // --- Mobile menu (keyboard-operable; Escape closes; focus restored) ---
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (navEl && toggle) {
      const open = () => {
        navEl.setAttribute('data-menu', 'open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
      };
      const close = (restore = true) => {
        navEl.setAttribute('data-menu', 'closed');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        if (restore) toggle.focus();
      };
      toggle.addEventListener('click', () => {
        if (navEl.getAttribute('data-menu') === 'open') close();
        else open();
      });
      document
        .querySelectorAll<HTMLElement>('[data-menu-link]')
        .forEach((l) => l.addEventListener('click', () => close(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && navEl.getAttribute('data-menu') === 'open') close();
      });
    }

    // --- Exposure reveal (opacity/rise). Additive + fail-open: content is never
    //     left hidden by JS. Anything already in/above the viewport reveals at
    //     once; the rest reveal on scroll; a safety timer reveals everything so a
    //     stalled observer can never hide primary content. ---
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revEls = Array.from(document.querySelectorAll<HTMLElement>('[data-bl-reveal]'));
    const revealAll = () => revEls.forEach((el) => el.classList.add('is-revealed'));
    if (reduce || !('IntersectionObserver' in window)) {
      revealAll();
    } else {
      const reveal = (el: Element) => el.classList.add('is-revealed');
      const vh = window.innerHeight;
      revEls.forEach((el) => {
        if (el.getBoundingClientRect().top < vh * 0.92) reveal(el);
      });
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              reveal(e.target);
              obs.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0 },
      );
      revEls.forEach((el) => {
        if (!el.classList.contains('is-revealed')) io.observe(el);
      });
      window.setTimeout(revealAll, 2600);
    }

    // --- Prototype quote form: preventDefault + acknowledgement ---
    const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
    const ack = document.querySelector<HTMLElement>('[data-quote-ack]');
    if (form && ack) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        ack.setAttribute('data-shown', 'true');
        ack.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      });
    }
  </script>
</PrototypeLayout>
