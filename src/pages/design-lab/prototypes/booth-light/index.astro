// --- Process: the application -> inspection arc ---
const process = [
  ['01', 'Strip & assess', 'An honest read on the metal before anything else is decided.', 'Read'],
  ['02', 'Metal & bodywork', 'Panels made true, gaps set — the base every reflection needs.', 'True'],
  ['03', 'Base · color · clear', 'Depth built in patient coats under a controlled booth key.', 'Build'],
  ['04', 'Inspection reveal', 'Read under one raking light until the reflection runs flat.', 'Expose'],
];
---

<PrototypeLayout
  title="After Hourz — Booth Light"
  description="Booth Light design direction for After Hourz: craft revealed through controlled inspection light. Concept prototype — reference imagery, not client work."
  bodyClass="bl-proto"
>
  <!-- LAB CHROME · subtle Design-Lab return (suppressible in client-review mode) -->
