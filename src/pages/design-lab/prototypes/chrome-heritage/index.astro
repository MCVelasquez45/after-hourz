---
import PrototypeLayout from '../../../../layouts/PrototypeLayout.astro';
import '../../../../styles/prototype-chrome-heritage.css';

/*
  PROTOTYPE — CHROME HERITAGE (production-level direction study)
  Route: /design-lab/prototypes/chrome-heritage   ·   Body class: .chp

  Replaces the rejected baseline. A contemporary digital evolution of the After Hourz
  poster: polished chrome + CANDY PAINT accent (sampled from a real candy/gold metalflake
  hood) against reflective darkness. Motion = POLISH / REFLECTION.

  NON-NEGOTIABLE guardrails honored:
   - Southern California framing only. NO NorCal marks / maps / QUINCY / NorCal badge.
   - Every external photo is PROTOTYPE / REFERENCE material — badged, never presented as
     Anthony's completed work.
   - Unknown business facts (phone / address / social / hours / pricing) are OMITTED or
     marked CLIENT INPUT REQUIRED — never fabricated.
   - All routes under /design-lab/*. No production routes.
*/

const P = '/assets/prototype';

// Curated Chrome Heritage reference photography. Each carries a provenance affordance.
const hero = {
  src: `${P}/chrome-heritage/impala-black-63-dusk-headlights-nJvfIaChd_A.jpg`,
  w: 2400,
  h: 1602,
  alt: 'A black 1963 Chevrolet Impala at dusk on wet asphalt, headlights lit, chrome wire wheels and grille catching a low warm light against a near-dark sky.',
};

const feature = {
  src: `${P}/materials-detail/candy-metalflake-hood-goldleaf-pinstriping-33Me56HyM_8.jpg`,
  w: 2400,
  h: 3600,
  alt: 'Extreme close-up of a candy-copper metalflake hood with fine gold-leaf scrollwork and hand pinstriping, chrome grille and bumper below catching light.',
};

// Services — the HERITAGE BUILD SHEET. Each lane is a ledger line with a big
// drop-cap numeral, a chrome hairline rule, and a right-aligned CANDY swatch chip
// (a real paint/finish family for that lane). Factual, no invented specifics.
const services = [
  {
    n: '01',
    name: 'Custom Paint',
    desc: 'Candy and metalflake color, factory-correct refinishing, and one-off custom work built in patient layers for depth that lasts.',
    tag: 'Color · Candy · Flake',
    swatch: 'candy',
    finish: 'Candy metalflake',
  },
  {
    n: '02',
    name: 'Body Work',
    desc: 'Collision repair, rust remediation, panel fabrication and gap-setting — the straight foundation every reflection depends on.',
    tag: 'Metal · Panels · Gaps',
    swatch: 'chrome',
    finish: 'Straight steel',
  },
  {
    n: '03',
    name: 'Restoration',
    desc: 'Classic and custom vehicles brought back true — and forward. Cars, trucks and bikes given an honest, complete read.',
    tag: 'Classic · Custom',
    swatch: 'leaf',
    finish: 'Gold-leaf lineage',
  },
  {
    n: '04',
    name: 'Detail & Polish',
    desc: 'Cut, buff and finish work — wet-sanded and polished until the reflection runs dead flat and the chrome reads clean.',
    tag: 'Cut · Buff · Chrome',
    swatch: 'asphalt',
    finish: 'Wet reflection',
  },
];

// Supporting gallery — reference rhythm (uneven, not an even masonry). Each badged.
const gallery = [
  {
    key: 'a',
    src: `${P}/chrome-heritage/impala-black-metalflake-rear-quarter-qw4YYpMVepA.jpg`,
    w: 2400,
    h: 3600,
    role: 'Body line',
    txt: 'Rear-quarter panel — a straight body line reading clean in reflection.',
    alt: 'Rear quarter panel of a black metalflake Impala, chrome trim and taillight catching light against darkness.',
    pos: '50% 42%',
  },
  {
    key: 'b',
    src: `${P}/chrome-heritage/black-classic-frontend-chrome-macro-oXU1iJOgViY.jpg`,
    w: 2400,
    h: 1602,
    role: 'Chrome macro',
    txt: 'Grille and bumper — the specular sweep proven on real polished metal.',
    alt: 'Macro of a black classic car front end, chrome grille bars and bumper throwing bright reflections.',
    pos: '50% 50%',
  },
  {
    key: 'c',
    src: `${P}/materials-detail/chrome-tailfin-bullet-taillight-AyzqxketKfM.jpg`,
    w: 2400,
    h: 2400,
    role: 'Heritage form',
    txt: 'Tailfin and bullet lamp — the mid-century silhouette in the DNA.',
    alt: 'Chrome tailfin with a bullet-style taillight, a sculptural mid-century form against a black surround.',
    pos: '50% 50%',
  },
  {
    key: 'd',
    src: `${P}/chrome-heritage/black-fender-chrome-wheelcover-macro-KM52A79uyqo.jpg`,
    w: 2400,
    h: 1602,
    role: 'Reflection',
    txt: 'Fender meeting wheel cover — deep gloss reflecting the room.',
    alt: 'Macro of a glossy black fender meeting a polished chrome wheel cover, sky and shapes reflected in the paint.',
    pos: '50% 55%',
  },
  {
    key: 'e',
    src: `${P}/chrome-heritage/blue-custom-chrome-goldenhour-detail-vYLZYaARV38.jpg`,
    w: 2400,
    h: 2400,
    role: 'Color event',
    txt: 'A cool candy blue at golden hour — the secondary voice, sparingly.',
    alt: 'Tight crop of a blue custom car panel with chrome detail catching warm golden-hour light.',
    pos: '30% 60%',
  },
];

// Process — POLISHED IN LAYERS. A literal layered paint-coat STACK (bottom coat →
// top coat), not four equal cells. Each coat is a horizontal band; the stack builds
// up to the final reflection. coat = the paint-schedule name that anchors the metaphor.
const process = [
  { n: '01', coat: 'Substrate', t: 'Strip & Read', b: 'The metal gets an honest read before anything else — what is true, and what is hidden underneath.' },
  { n: '02', coat: 'Foundation', t: 'Metal & Gaps', b: 'Panels made straight and gaps set even. The flat foundation every later reflection depends on.' },
  { n: '03', coat: 'Color coats', t: 'Base · Candy · Flake', b: 'Built up in patient layers — base, candy and metalflake. Depth is earned in the booth, not rushed.' },
  { n: '04', coat: 'Clear & cut', t: 'Clear & Reflect', b: 'Clearcoat laid, then wet-sanded, cut and buffed until the surface runs dead flat and the light rakes clean.' },
];

const materials = [
  ['candy', 'Candy Metalflake', 'Deep pooled candy over a sparse specular flake — depth in layers, the brand-core hue.'],
  ['chrome', 'Polished Chrome', 'A hard light-to-dark ladder with one raking highlight — a lit edge, never a gray fill.'],
  ['leaf', 'Gold-Leaf Stripe', 'Hand-laid leaf and pinstripe — the custom-lettering lineage behind the wordmark.'],
  ['asphalt', 'Wet Asphalt', 'Near-black ground holding a single warm reflection — the after-hours light.'],
];

const navLinks = [
  ['#work', 'Work'],
  ['#process', 'Process'],
  ['#services', 'Services'],
  ['#story', 'Story'],
  ['#contact', 'Contact'],
];
---

<PrototypeLayout
  title="After Hourz — Chrome Heritage"
  description="Chrome Heritage design direction for After Hourz. Concept prototype — reference imagery, not client work."
  bodyClass="chp"
>
  <!-- ============ LAB TOPLINE (subtle, suppressible in client-review) ============ -->
  <div class="chp-topline">
    <div class="chp-wrap chp-topline__row">
      <span>Design Lab · Prototype 01 · Chrome Heritage · Concept — not client-approved</span>
      <span><a href="/design-lab/">&larr; Design Lab</a></span>
    </div>
  </div>

  <!-- ============ NAV ============ -->
  <header class="chp-nav" data-scrolled="false" data-open="false">
    <div class="chp-wrap chp-nav__row">
      <a class="chp-brand" href="#top" aria-label="After Hourz — home">
        <span class="chp-chrome-text">After&nbsp;Hour<span class="chp-brand__z">z</span></span>
      </a>

      <button
        class="chp-burger"
        type="button"
        aria-expanded="false"
        aria-controls="chp-menu"
        aria-label="Open menu"
      >
        <span class="chp-burger__bars" aria-hidden="true"></span>
      </button>

      <nav class="chp-nav__links" id="chp-menu" aria-label="Primary">
        {navLinks.map(([href, label]) => <a href={href}>{label}</a>)}
        <a class="chp-btn chp-btn--primary chp-nav__cta" href="#contact">Request a Quote</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="chp-hero" id="top" aria-labelledby="hero-h">
      <img
        class="chp-hero__img"
        src={hero.src}
        width={hero.w}
        height={hero.h}
        alt={hero.alt}
        fetchpriority="high"
        decoding="async"
      />
      <div class="chp-hero__grade" aria-hidden="true"></div>
      <div class="chp-hero__highlight" aria-hidden="true"></div>
      <div class="chp-hero__sheen" aria-hidden="true"></div>

      <!-- SAME provenance badge the gallery uses — the hero is not exempt -->
      <span class="chp-ref chp-ref--hero">Reference imagery</span>

      <div class="chp-wrap">
        <div class="chp-hero__content">
          <p class="chp-hero__eyebrow">After Hourz · Anthony Montoya</p>
          <h1 class="chp-hero__title" id="hero-h">
            <span class="chp-hero__l1">Built after hours,</span>
            <em class="chp-hero__l2">finished by hand.</em>
          </h1>
          <p class="chp-hero__kicker">
            <b>Custom paint · body work · restoration</b>
            <span class="chp-hero__region"> — Southern California</span>
          </p>
          <div class="chp-hero__actions">
            <a class="chp-btn chp-btn--primary" href="#contact">Request a Quote</a>
            <a class="chp-btn chp-btn--ghost" href="#work">
              See the work <span class="chp-arw" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SERVICES ============ -->
    <section class="chp-section" id="services" aria-labelledby="services-h">
      <div class="chp-wrap">
        <div class="chp-section__head" data-reveal>
          <p class="chp-eyebrow">
            <span class="chp-eyebrow__n">01</span> Services
            <span class="chp-eyebrow__rule" aria-hidden="true"></span>
          </p>
          <h2 class="chp-title" id="services-h">The build sheet</h2>
          <p class="chp-lead">
            Cars, trucks and bikes. Four lines on every build sheet — each an honest read
            on the metal, and the finish family it&rsquo;s carried in.
          </p>
        </div>

        <!-- HERITAGE BUILD SHEET / MAGAZINE LEDGER: drop-cap numerals, chrome hairline
             rules, and a right-aligned CANDY finish swatch chip per lane. -->
        <div class="chp-sheet" data-reveal>
          <div class="chp-sheet__colhead" aria-hidden="true">
            <span>No.</span>
            <span>Line of work</span>
            <span class="chp-sheet__colhead-fin">Finish family</span>
          </div>
          {services.map((s) => (
            <article class="chp-line">
              <span class="chp-line__n" aria-hidden="true">{s.n}</span>
              <div class="chp-line__body">
                <h3 class="chp-line__name">{s.name}</h3>
                <p class="chp-line__desc">{s.desc}</p>
                <span class="chp-line__tag">{s.tag}</span>
              </div>
              <div class="chp-line__finish">
                <span class={`chp-chip chp-chip--${s.swatch}`} aria-hidden="true"></span>
                <span class="chp-line__finlabel">{s.finish}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ WORK / BUILDS ============ -->
    <section class="chp-work chp-section" id="work" aria-labelledby="work-h">
      <div class="chp-wrap">
        <div class="chp-section__head" data-reveal>
          <p class="chp-eyebrow">
            <span class="chp-eyebrow__n">02</span> Work
            <span class="chp-eyebrow__rule" aria-hidden="true"></span>
          </p>
          <h2 class="chp-title" id="work-h">Iron worth the hours</h2>
          <p class="chp-lead">
            A look at the finish this direction is built to hold. Every image below is
            reference material chosen to prove the Chrome Heritage look.
          </p>
        </div>
      </div>

      <!-- Dominant full-bleed feature -->
      <figure class="chp-feature">
        <img
          class="chp-feature__img"
          src={feature.src}
          width={feature.w}
          height={feature.h}
          alt={feature.alt}
          loading="lazy"
          decoding="async"
        />
        <div class="chp-feature__grade" aria-hidden="true"></div>
        <span class="chp-ref">Reference · not client work</span>
        <figcaption class="chp-feature__cap">
          <p class="chp-feature__eyebrow">Finish study · candy metalflake</p>
          <h3 class="chp-feature__title">Candy, flake &amp; gold-leaf</h3>
          <p class="chp-feature__desc">
            Deep candy over metalflake, hand-laid gold-leaf scroll and pinstripe — the depth
            and lettering lineage this direction is drawn from.
          </p>
        </figcaption>
      </figure>

      <div class="chp-wrap">
        <!-- ONE clear provenance caption for the whole block — not a badge per tile.
             The full-bleed feature above carries its own single badge. -->
        <p class="chp-gallery__prov">
          <span class="chp-gallery__prov-dot" aria-hidden="true"></span>
          Reference imagery — study crops, not Anthony&rsquo;s completed work.
        </p>
        <div class="chp-gallery" data-reveal>
          {gallery.map((g) => (
            <figure class={`chp-shot chp-shot--${g.key}`}>
              <img
                src={g.src}
                width={g.w}
                height={g.h}
                alt={g.alt}
                loading="lazy"
                decoding="async"
                style={`object-position:${g.pos};`}
              />
              <figcaption class="chp-shot__cap">
                <span class="chp-shot__role">{g.role}</span>
                <span class="chp-shot__txt">{g.txt}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <p class="chp-work__note">
          <b>Prototype imagery is external reference material</b>, selected to prove the Chrome
          Heritage look — never presented as Anthony&rsquo;s completed work. Production portfolio
          must be his real, shot builds, graded to this candy-on-chrome family. Missing shots are
          marked CLIENT INPUT REQUIRED, never fabricated.
        </p>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section class="chp-section" id="process" aria-labelledby="process-h">
      <div class="chp-wrap">
        <div class="chp-section__head" data-reveal>
          <p class="chp-eyebrow">
            <span class="chp-eyebrow__n">03</span> Process
            <span class="chp-eyebrow__rule" aria-hidden="true"></span>
          </p>
          <h2 class="chp-title" id="process-h">Polished in layers</h2>
          <p class="chp-lead">
            A finish is made, not sprayed. Four moves on every project, in the order that
            earns a reflection you can read.
          </p>
        </div>

        <!-- LAYERED PAINT-COAT STACK: coats build bottom → top toward the final
             reflection. Deliberately NOT four equal cells. -->
        <ol class="chp-stack" aria-label="The layered build — four coats">
          {process.map((p, i) => (
            <li class={`chp-coat chp-coat--${p.n}`} data-reveal style={`--i:${i}`}>
              <span class="chp-coat__n" aria-hidden="true">{p.n}</span>
              <span class="chp-coat__label">{p.coat}</span>
              <div class="chp-coat__body">
                <h3 class="chp-coat__t">{p.t}</h3>
                <p class="chp-coat__b">{p.b}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section class="chp-section" id="story" aria-labelledby="story-h">
      <div class="chp-wrap">
        <div class="chp-story">
          <div class="chp-story__body" data-reveal>
            <p class="chp-eyebrow">
              <span class="chp-eyebrow__n">04</span> The Shop
              <span class="chp-eyebrow__rule" aria-hidden="true"></span>
            </p>
            <h2 class="chp-title" id="story-h">After Hourz</h2>
            <p>
              After Hourz is a Southern California custom shop owned by <b>Anthony Montoya</b>,
              built on the work that happens once the world goes quiet — the patient hours where
              a finish is actually made.
            </p>
            <p>
              The name is literal. Depth in candy paint, a straight body line, chrome that reads
              clean in reflection — none of it is rushed. It is body work, custom paint and
              restoration for people who want the metal done right.
            </p>
            <blockquote class="chp-quote">
              &ldquo;The metal gets an honest read before anything else.&rdquo;
            </blockquote>
          </div>

          <div class="chp-materials" data-reveal aria-label="Material and light studies">
            {materials.map(([mod, name, desc]) => (
              <div class={`chp-mat chp-mat--${mod}`}>
                <span class="chp-mat__sw" aria-hidden="true"></span>
                <div>
                  <div class="chp-mat__name">{name}</div>
                  <p class="chp-mat__desc">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <section class="chp-section" id="contact" aria-labelledby="contact-h">
      <div class="chp-wrap">
        <div class="chp-contact-grid">
          <div class="chp-contact__intro" data-reveal>
            <p class="chp-eyebrow">
              <span class="chp-eyebrow__n">05</span> Contact
              <span class="chp-eyebrow__rule" aria-hidden="true"></span>
            </p>
            <h2 class="chp-title" id="contact-h">Request a quote</h2>
            <p>
              Tell us what you&rsquo;re building. No pressure, no upsell — just an honest read on
              the work and what it takes to do it right.
            </p>
            <ul class="chp-contact__channels">
              <li class="chp-channel">
                <span class="chp-channel__label">Phone</span>
                <span class="chp-channel__val chp-channel__val--req">CLIENT INPUT REQUIRED</span>
              </li>
              <li class="chp-channel">
                <span class="chp-channel__label">Shop / Area</span>
                <span class="chp-channel__val">Southern California
                  <span class="chp-channel__val--req"> — exact address: CLIENT INPUT REQUIRED</span>
                </span>
              </li>
              <li class="chp-channel">
                <span class="chp-channel__label">Instagram</span>
                <span class="chp-channel__val chp-channel__val--req">CLIENT INPUT REQUIRED</span>
              </li>
            </ul>
          </div>

          <form class="chp-form chp-plaque" id="chp-quote" novalidate data-reveal>
            <div class="chp-form__grid">
              <div class="chp-field">
                <label for="q-name">Name <span class="req" aria-hidden="true">*</span></label>
                <input id="q-name" name="name" type="text" autocomplete="name" required placeholder="Your name" />
              </div>
              <div class="chp-field">
                <label for="q-vehicle">Vehicle <span class="req" aria-hidden="true">*</span></label>
                <input id="q-vehicle" name="vehicle" type="text" required placeholder="Year · make · model" />
              </div>
              <div class="chp-field chp-field--full">
                <label for="q-service">Service</label>
                <select id="q-service" name="service">
                  <option value="">Select a lane…</option>
                  <option>Custom Paint</option>
                  <option>Body Work</option>
                  <option>Restoration</option>
                  <option>Detail &amp; Polish</option>
                  <option>Not sure yet</option>
                </select>
              </div>
              <div class="chp-field chp-field--full">
                <label for="q-message">What do you want done? <span class="req" aria-hidden="true">*</span></label>
                <textarea id="q-message" name="message" rows="4" required placeholder="Paint, bodywork, restoration — tell us about the build."></textarea>
              </div>
            </div>

            <div class="chp-form__actions">
              <button class="chp-btn chp-btn--primary" type="submit">Send request</button>
              <p class="chp-form__note">
                Prototype form — not wired to a backend. Nothing is sent.
              </p>
            </div>

            <p class="chp-ack" id="chp-ack" hidden role="status" aria-live="polite">
              Thanks — this is a <b>prototype</b>, so nothing was actually sent. In the live
              site this would reach the shop. Contact channels are marked
              <b>CLIENT INPUT REQUIRED</b> until confirmed.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="chp-footer">
    <div class="chp-wrap">
      <div class="chp-footer__top">
        <div>
          <div class="chp-footer__brand">After&nbsp;Hour<span class="chp-brand__z">z</span></div>
          <p class="chp-footer__tagline">
            Custom paint, body work and restoration. Southern California. Built after hours,
            finished by hand.
          </p>
        </div>
        <div class="chp-footer__col">
          <h4>Explore</h4>
          <ul>
            {navLinks.map(([href, label]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </div>
        <div class="chp-footer__col">
          <h4>Contact</h4>
          <ul>
            <li><span>Phone · <span class="chp-footer__req">CLIENT INPUT REQUIRED</span></span></li>
            <li><span>Address · <span class="chp-footer__req">CLIENT INPUT REQUIRED</span></span></li>
            <li><span>Instagram · <span class="chp-footer__req">CLIENT INPUT REQUIRED</span></span></li>
          </ul>
        </div>
      </div>
      <div class="chp-footer__bottom">
        <span class="chp-footer__prov">
          Prototype — reference imagery, not client work. Concept direction: Chrome Heritage.
        </span>
        <span><a href="/design-lab/">Back to Design Lab</a></span>
      </div>
    </div>
  </footer>

  <!-- ============ STICKY MOBILE CONTACT BAR ============ -->
  <div class="chp-mobilebar" aria-label="Quick contact">
    <a class="chp-mobilebar__call" href="#contact">Call</a>
    <a class="chp-mobilebar__quote" href="#contact">Request a Quote</a>
  </div>

  <!-- ============ ISOLATED JS — nav scroll state, mobile menu, form ============ -->
  <script>
    // Nav: scrolled state (bg on scroll)
    const nav = document.querySelector<HTMLElement>('.chp-nav');
    if (nav) {
      const setScrolled = () =>
        nav.setAttribute('data-scrolled', String(window.scrollY > 24));
      setScrolled();
      window.addEventListener('scroll', setScrolled, { passive: true });

      // Mobile menu (keyboard operable)
      const burger = nav.querySelector<HTMLButtonElement>('.chp-burger');
      const menu = nav.querySelector<HTMLElement>('.chp-nav__links');
      const setOpen = (open: boolean) => {
        nav.setAttribute('data-open', String(open));
        burger?.setAttribute('aria-expanded', String(open));
        burger?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      burger?.addEventListener('click', () => {
        setOpen(nav.getAttribute('data-open') !== 'true');
      });
      // Close on link click + on Escape (restore focus to burger)
      menu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => setOpen(false)),
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.getAttribute('data-open') === 'true') {
          setOpen(false);
          burger?.focus();
        }
      });
    }

    // Prototype quote form — preventDefault + tasteful acknowledgement
    const form = document.querySelector<HTMLFormElement>('#chp-quote');
    const ack = document.querySelector<HTMLElement>('#chp-ack');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (ack) {
        ack.hidden = false;
        ack.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  </script>
</PrototypeLayout>
