---
export const prerender = true;
import PrototypeLayout from '../../../../layouts/PrototypeLayout.astro';
import '../../../../styles/board-after-dark.css';

// AFTER DARK — internal art-direction board (Design Lab · direction study).
// External stock is PROTOTYPE / reference material only — never presented as Anthony's
// completed work. Unknown business facts are omitted, never fabricated.

const P = '/assets/prototype';

// Curated photography for this direction. `class` = provenance/role handling.
const shots = [
  {
    src: `${P}/environment-dusk/vintage-truck-foggy-gas-station-night-o2GgDamhkQA.jpg`,
    w: 2400,
    h: 4267,
    span: 'tall',
    role: 'Hero plate',
    cap: 'Front-quarter emerging bottom-right from cool fog; warm sodium canopy top-left, wet asphalt doubling the light. Crop keeps the empty sky for the wordmark.',
    prov: 'Prototype reference · stock',
    alt: 'Vintage truck parked at a foggy gas station at night, warm neon canopy glowing against cool fog on wet asphalt.',
  },
  {
    src: `${P}/environment-dusk/cinema-exterior-dusk-graded-sky-4AzQw1JCl_Q.jpg`,
    w: 2400,
    h: 1920,
    span: 'wide',
    role: 'Establishing plate',
    cap: 'Graded dusk sky, blue-to-sodium band along the horizon. Huge upper negative space — the section-title chapter break.',
    prov: 'Prototype reference · stock',
    alt: 'Low single-story building at dusk under a deep blue sky graded to warm orange at the horizon.',
  },
  {
    src: `${P}/chrome-heritage/green-lowrider-night-pinstripe-goldwheel-J3vo0W5buXc.jpg`,
    w: 2400,
    h: 3491,
    span: 'sq',
    role: 'Culture',
    cap: 'Gold wire wheel, teal pinstripe scrollwork, door open on a teal interior — West Coast lowrider craft at night. Tight on the wheel-and-stripe.',
    prov: 'Prototype reference · stock',
    alt: 'Green lowrider at night showing a gold wire-spoke wheel, whitewall tire, and teal pinstripe scrollwork on the body.',
  },
  {
    src: `${P}/culture-vehicles/classic-chevy-c10-pickup-warm-dusk-6d1tDrPryEQ.jpg`,
    w: 2400,
    h: 1600,
    span: '',
    role: 'Story',
    cap: 'Classic C10 in warm dusk light — body-line study for the mid-page narrative band.',
    prov: 'Prototype reference · stock',
    alt: 'Classic Chevrolet C10 pickup photographed in warm dusk light.',
  },
  {
    src: `${P}/culture-vehicles/mechanic-under-car-lowangle-craft-jL9zfzTVSwY.jpg`,
    w: 2400,
    h: 3600,
    span: '',
    role: 'The hand',
    cap: 'Low-angle craft portrait under a lift. Placeholder for real process shots — Anthony’s own hands: CLIENT INPUT REQUIRED.',
    prov: 'Prototype reference · not Anthony',
    alt: 'A mechanic works beneath a raised vehicle in a workshop, looking up at the underbody.',
  },
  {
    src: `${P}/materials-detail/red-rear-quarter-round-taillights-qTWq8VDi_3I.jpg`,
    w: 2400,
    h: 3600,
    span: '',
    role: 'Light energy',
    cap: 'Rear-quarter taillight glow — kept as a lighting/crop reference for taillight-energy accents, not a portfolio build.',
    prov: 'Prototype reference · lighting study',
    alt: 'Close crop of a glossy red car rear quarter panel with round taillights reflecting studio light.',
  },
];
---

<PrototypeLayout
  title="After Hourz — After Dark · Art-Direction Board"
  description="Internal art-direction board for the After Dark direction of After Hourz. Design Lab direction study — concept, not client-approved."
  bodyClass="adb"
>
  <!-- =========================================================
       1 · BOARD HEADER
       ========================================================= -->
  <header class="adb-masthead" id="board">
    <div class="adb-wrap">
      <span class="adb-tag">Design Lab · Direction Study · Concept — not client-approved</span>

      <div class="adb-masthead__grid">
        <div>
          <h1 class="adb-dirname">
            After<span class="dark">Dark</span>
          </h1>
          <p class="adb-thesis">
            Southern California custom-car craftsmanship after sunset — warm sodium light against a
            cool night, wet asphalt, and the momentum of a shop that keeps working once the doors
            roll down.
          </p>
        </div>

        <div class="adb-facts">
          <div>
            <div class="adb-fact__k">Poster DNA</div>
            <p class="adb-fact__v">
              Near-monochrome <strong>blue · silver · black</strong> with warm amber pinpoints — the
              poster’s one-warm-accent contrast, evolved into real light not faked bevel.
            </p>
          </div>
          <div>
            <div class="adb-fact__k">Motion keyword</div>
            <p class="adb-fact__v">
              <strong>Momentum</strong> — horizontal drift, parallax dusk layers, cut-to-cut rhythm.
            </p>
          </div>
          <div>
            <div class="adb-fact__k">Voice</div>
            <p class="adb-fact__v">
              Understated confidence. The finish speaks; the copy stays quiet.
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- =========================================================
         2 · HERO INTENT — the money shot
         ========================================================= -->
    <section class="adb-hero" aria-labelledby="hero-h">
      <div class="adb-hero__frame">
        <img
          class="adb-hero__img"
          src={`${P}/environment-dusk/vintage-truck-foggy-gas-station-night-o2GgDamhkQA.jpg`}
          width="2400"
          height="4267"
          alt="Vintage truck at a foggy gas station at night — warm neon canopy over cool fog, wet asphalt reflecting the light."
          loading="eager"
          fetchpriority="high"
        />
        <div class="adb-hero__grade" aria-hidden="true"></div>
        <div class="adb-hero__scan" aria-hidden="true"></div>
        <p class="adb-hero__note">
          Prototype reference imagery — direction intent, not a real After Hourz build.
        </p>

        <div class="adb-hero__content" data-reveal>
          <p class="adb-hero__eyebrow">Hero intent · full-viewport</p>
          <h2 class="adb-hero__head" id="hero-h">
            Pull up<span class="warm">after dark.</span>
          </h2>
          <p class="adb-hero__sub">
            Body, paint, and restoration built the way Southern California builds it — patient,
            hand-finished, and worth the drive across town at night.
          </p>
          <div class="adb-hero__row">
            <a class="adb-btn adb-btn--sodium" href="#comp">
              See the work{' '}
              <span class="arw" aria-hidden="true">
                &rarr;
              </span>
            </a>
            <a class="adb-btn adb-btn--ghost" href="#type">
              Explore the system
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         3 · TYPOGRAPHY SYSTEM
         ========================================================= -->
    <section class="adb-section" id="type" aria-labelledby="s3">
      <div class="adb-wrap">
        <div class="adb-slate">
          <span class="adb-slate__no">03</span>
          <div class="adb-slate__meta">
            <span class="adb-kicker">Typography System</span>
            <h2 class="adb-slate__title" id="s3">
              Two voices: cinematic + humanist
            </h2>
          </div>
          <p class="adb-slate__note">
            Tall condensed display for impact; a warm humanist sans for everything you read. Real
            self-hosted faces, driven by the direction’s font tokens.
          </p>
        </div>

        <div class="adb-type">
          <!-- Display -->
          <div class="adb-type__row" data-reveal>
            <dl class="adb-type__spec">
              <div>
                <dt>Display</dt>
                <dd>
                  <b>Bebas Neue</b>
                </dd>
                <dd>--ad-font-display</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>
                  Headlines, wordmark support, section numerals. Tall, condensed, set BIG with open
                  tracking.
                </dd>
              </div>
            </dl>
            <div>
              <p class="adb-specimen-display">
                Craft that
                <br />
                <span class="glow">runs late.</span>
              </p>
              <p class="adb-glyphs">ABCDEFGHIJKLM NOPQRSTUVWXYZ 0123456789 &amp; · —</p>
              <div class="adb-scale" aria-hidden="true">
                <span style="font-size:3.2rem">
                  Display <i>clamp 3.4 → 9.5rem</i>
                </span>
                <span style="font-size:2.2rem">
                  Section title <i>1.6 → 2.5rem</i>
                </span>
                <span style="font-size:1.5rem">
                  Subhead <i>H4 · 1.563rem</i>
                </span>
              </div>
            </div>
          </div>

          <!-- Body -->
          <div class="adb-type__row" data-reveal>
            <dl class="adb-type__spec">
              <div>
                <dt>Body</dt>
                <dd>
                  <b>Sora</b>
                </dd>
                <dd>--ad-font-body</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>
                  Paragraphs, UI, labels, eyebrows. Humanist warmth balances the hard display face;
                  kept to three weights.
                </dd>
              </div>
            </dl>
            <div class="adb-specimen-body">
              <p class="lead">
                A finish only shows what’s underneath. After Dark reads like the shop at midnight —
                quiet, precise, lit by one warm source against the cool.
              </p>
              <p>
                We build the metal true before a drop of color goes down: panels aligned, gaps set,
                primer blocked flat. Then base, candy, and clear go on in patient layers until the
                reflection runs straight down the body line. Measure of 62 characters; line-height
                1.62 for calm reading on a dark ground.
              </p>
              <div class="adb-weights">
                <span class="w4">
                  Regular 400<small>Body copy</small>
                </span>
                <span class="w6">
                  Semibold 600<small>Labels · eyebrows</small>
                </span>
                <span class="w7">
                  Bold 700<small>Emphasis</small>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         4 · WORDMARK STUDY
         ========================================================= -->
    <section class="adb-section" id="mark" aria-labelledby="s4">
      <div class="adb-wrap">
        <div class="adb-slate">
          <span class="adb-slate__no">04</span>
          <div class="adb-slate__meta">
            <span class="adb-kicker">Wordmark Study</span>
            <h2 class="adb-slate__title" id="s4">
              AFTER HOURZ — three routes
            </h2>
          </div>
          <p class="adb-slate__note">
            Evolves the poster’s chrome-heritage identity toward light and momentum. The exaggerated{' '}
            <b>Z</b> terminal is carried as the identity flourish; blackletter is not reproduced
            literally.
          </p>
        </div>

        <div class="adb-marks">
          <!-- Concept A — Sodium Cut -->
          <div class="adb-mark" data-reveal>
            <div class="adb-mark__stage">
              <svg
                viewBox="0 0 300 120"
                role="img"
                aria-label="After Hourz wordmark, concept A — Sodium Cut"
              >
                <defs>
                  <linearGradient id="adm-a" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#ffc07a" />
                    <stop offset="1" stop-color="#ff9d4d" />
                  </linearGradient>
                </defs>
                <text
                  x="150"
                  y="44"
                  text-anchor="middle"
                  font-family="'Bebas Neue', sans-serif"
                  font-size="30"
                  letter-spacing="5"
                  fill="#f4efe8"
                >
                  AFTER
                </text>
                <text
                  x="150"
                  y="92"
                  text-anchor="middle"
                  font-family="'Bebas Neue', sans-serif"
                  font-size="46"
                  letter-spacing="3"
                  fill="url(#adm-a)"
                >
                  HOUR
                  <tspan font-size="60" dy="2">
                    Z
                  </tspan>
                </text>
                <rect x="60" y="52" width="180" height="2" fill="#ff9d4d" opacity="0.7" />
              </svg>
            </div>
            <div class="adb-mark__label">
              <span class="adb-mark__concept">Concept A · Sodium Cut</span>
              <p class="adb-mark__desc">
                Condensed stack, HOURZ dipped in sodium gradient. Enlarged Z drops below the
                baseline — the flourish, machined not ornate. Hairline rule = the street.
              </p>
            </div>
          </div>

          <!-- Concept B — Night Shift Lockup -->
          <div class="adb-mark" data-reveal data-delay="80">
            <div class="adb-mark__stage">
              <svg
                viewBox="0 0 300 120"
                role="img"
                aria-label="After Hourz wordmark, concept B — Night Shift lockup"
              >
                <line x1="20" y1="60" x2="46" y2="60" stroke="#ff9d4d" stroke-width="2" />
                <text
                  x="54"
                  y="52"
                  font-family="'Bebas Neue', sans-serif"
                  font-size="24"
                  letter-spacing="6"
                  fill="#a9b1be"
                >
                  AFTER
                </text>
                <text
                  x="54"
                  y="92"
                  font-family="'Bebas Neue', sans-serif"
                  font-size="42"
                  letter-spacing="3"
                  fill="#f4efe8"
                >
                  HOUR
                  <tspan fill="#ff9d4d" font-size="54">
                    Z
                  </tspan>
                </text>
                <line x1="20" y1="60" x2="20" y2="60" stroke="#ff9d4d" stroke-width="2" />
              </svg>
            </div>
            <div class="adb-mark__label">
              <span class="adb-mark__concept">Concept B · Night Shift</span>
              <p class="adb-mark__desc">
                Left-aligned two-tier lockup — quiet AFTER over loud HOURZ. Sodium tick = practical
                shop light. Reads confidently in a sticky nav at small sizes.
              </p>
            </div>
          </div>

          <!-- Concept C — Chrome Rake -->
          <div class="adb-mark" data-reveal data-delay="160">
            <div class="adb-mark__stage">
              <svg
                viewBox="0 0 300 120"
                role="img"
                aria-label="After Hourz wordmark, concept C — Chrome Rake"
              >
                <defs>
                  <linearGradient id="adm-c" x1="0" y1="0" x2="1" y2="0.4">
                    <stop offset="0" stop-color="#4a5666" />
                    <stop offset="0.44" stop-color="#cfd7e2" />
                    <stop offset="0.5" stop-color="#f4f8fc" />
                    <stop offset="0.58" stop-color="#8b98a8" />
                    <stop offset="1" stop-color="#2c3542" />
                  </linearGradient>
                </defs>
                <text
                  x="150"
                  y="72"
                  text-anchor="middle"
                  font-family="'Bebas Neue', sans-serif"
                  font-size="54"
                  letter-spacing="2"
                  fill="url(#adm-c)"
                >
                  AFTER HOUR<tspan fill="#ff9d4d">Z</tspan>
                </text>
                <text
                  x="150"
                  y="98"
                  text-anchor="middle"
                  font-family="'Sora', sans-serif"
                  font-weight="600"
                  font-size="8"
                  letter-spacing="7"
                  fill="#a9b1be"
                >
                  AUTO BODY · PAINT · RESTORATION
                </text>
              </svg>
            </div>
            <div class="adb-mark__label">
              <span class="adb-mark__concept">Concept C · Chrome Rake</span>
              <p class="adb-mark__desc">
                Single-line chrome gradient — the poster’s dark-metal → white specular → dark-metal
                rake as a real edge-light. One warm Z. Descriptor in the humanist voice.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         5 · PALETTE
         ========================================================= -->
    <section class="adb-section" id="palette" aria-labelledby="s5">
      <div class="adb-wrap">
        <div class="adb-slate">
          <span class="adb-slate__no">05</span>
          <div class="adb-slate__meta">
            <span class="adb-kicker">Palette</span>
            <h2 class="adb-slate__title" id="s5">
              Cool night, one warm heat
            </h2>
          </div>
          <p class="adb-slate__note">
            Near-monochrome blue/silver/black with sodium as the only warmth — pulled from the
            <code>--ad-*</code> tokens. Warm pixels stay a small, precious fraction.
          </p>
        </div>

        <div class="adb-swatches" data-reveal>
          <div class="adb-sw adb-sw--dark" style="background:#0b0e14;">
            <span class="adb-sw__name">Night</span>
            <span class="adb-sw__hex">#0B0E14</span>
            <span class="adb-sw__role">Base ground — the after-hours dark</span>
          </div>
          <div class="adb-sw adb-sw--dark" style="background:#101318;">
            <span class="adb-sw__name">Asphalt</span>
            <span class="adb-sw__hex">#101318</span>
            <span class="adb-sw__role">Wet-ground surface / insets</span>
          </div>
          <div class="adb-sw adb-sw--dark" style="background:#14233f;">
            <span class="adb-sw__name">Dusk Top</span>
            <span class="adb-sw__hex">#14233F</span>
            <span class="adb-sw__role">Top of the dusk gradient sky</span>
          </div>
          <div
            class="adb-sw adb-sw--dark"
            style="background:linear-gradient(120deg,#3a2a3f,#6d3b2f);"
          >
            <span class="adb-sw__name">Dusk Mid → Low</span>
            <span class="adb-sw__hex">#3A2A3F · #6D3B2F</span>
            <span class="adb-sw__role">Horizon band — cool violet into warm</span>
          </div>
          <div class="adb-sw adb-sw--dark" style="background:#3f7bd6;">
            <span class="adb-sw__name">Cool Blue</span>
            <span class="adb-sw__hex">#3F7BD6</span>
            <span class="adb-sw__role">Cool key light / chrome rim / data</span>
          </div>
          <div class="adb-sw adb-sw--light" style="background:#ff9d4d;">
            <span class="adb-sw__name">Sodium</span>
            <span class="adb-sw__hex">#FF9D4D</span>
            <span class="adb-sw__role">The one heat — CTA, active, accent</span>
          </div>
          <div class="adb-sw adb-sw--light" style="background:#ffc07a;">
            <span class="adb-sw__name">Sodium Hot</span>
            <span class="adb-sw__hex">#FFC07A</span>
            <span class="adb-sw__role">Hover / brighter specular of the heat</span>
          </div>
          <div class="adb-sw adb-sw--light" style="background:#f4efe8;">
            <span class="adb-sw__name">Warm White</span>
            <span class="adb-sw__hex">#F4EFE8</span>
            <span class="adb-sw__role">Headline / peak highlight on dark</span>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         6 · PHOTOGRAPHY
         ========================================================= -->
    <section class="adb-section" id="photo" aria-labelledby="s6">
      <div class="adb-wrap adb-wrap--wide">
        <div class="adb-slate">
          <span class="adb-slate__no">06</span>
          <div class="adb-slate__meta">
            <span class="adb-kicker">Photography</span>
            <h2 class="adb-slate__title" id="s6">
              Cinematic, warm-against-cool, honest
            </h2>
          </div>
          <p class="adb-slate__note">
            One cool key + warm practical + deep falloff. All images below are prototype reference —
            never presented as Anthony’s completed work. Real builds &amp; process shots:{' '}
            <b>CLIENT INPUT REQUIRED</b>.
          </p>
        </div>

        <div class="adb-photo" data-reveal>
          {shots.map((s) => (
            <figure
              class={`adb-shot ${s.span === 'tall' ? 'adb-shot--tall' : s.span === 'wide' ? 'adb-shot--wide' : s.span === 'sq' ? 'adb-shot--sq' : ''}`}
            >
              <img
                src={s.src}
                width={s.w}
                height={s.h}
                alt={s.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="adb-shot__role">{s.role}</span>
                <span class="adb-shot__cap">{s.cap}</span>
                <span class="adb-shot__prov">{s.prov}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================================================
         7 · MATERIAL & LIGHT (CSS-rendered)
         ========================================================= -->
    <section class="adb-section" id="material" aria-labelledby="s7">
      <div class="adb-wrap">
        <div class="adb-slate">
          <span class="adb-slate__no">07</span>
          <div class="adb-slate__meta">
            <span class="adb-kicker">Material &amp; Light</span>
            <h2 class="adb-slate__title" id="s7">
              Real light, no raster textures
            </h2>
          </div>
          <p class="adb-slate__note">
            Each surface below is pure CSS — gradients and blend modes standing in for the material
            moments the prototype will render for real.
          </p>
        </div>

        <div class="adb-mat" data-reveal>
          <div class="adb-mat__cell">
            <div class="adb-mat__swatch mat-asphalt" aria-hidden="true"></div>
            <div class="adb-mat__cap">
              <span class="adb-mat__t">Wet asphalt</span>
              <span class="adb-mat__d">
                Sodium + cool reflections mirrored on a wet ground — the poster’s doubled light.
              </span>
            </div>
          </div>
          <div class="adb-mat__cell">
            <div class="adb-mat__swatch mat-sodium" aria-hidden="true"></div>
            <div class="adb-mat__cap">
              <span class="adb-mat__t">Sodium halo</span>
              <span class="adb-mat__d">
                A practical light blooming through fog — the single warm source per scene.
              </span>
            </div>
          </div>
          <div class="adb-mat__cell">
            <div class="adb-mat__swatch mat-candy" aria-hidden="true"></div>
            <div class="adb-mat__cap">
              <span class="adb-mat__t">Candy clearcoat</span>
              <span class="adb-mat__d">
                Deep flake blue with a hard specular rake — paint depth as the color event.
              </span>
            </div>
          </div>
          <div class="adb-mat__cell">
            <div class="adb-mat__swatch mat-chrome" aria-hidden="true"></div>
            <div class="adb-mat__cap">
              <span class="adb-mat__t">Chrome / wire</span>
              <span class="adb-mat__d">
                Dark-metal → white specular → dark-metal edge-light with a warm sodium catch.
              </span>
            </div>
          </div>
          <div class="adb-mat__cell">
            <div class="adb-mat__swatch mat-taillight" aria-hidden="true"></div>
            <div class="adb-mat__cap">
              <span class="adb-mat__t">Taillight glow</span>
              <span class="adb-mat__d">
                Rear-quarter energy — twin red halos reflected downward for momentum accents.
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         8 · GRID & UI
         ========================================================= -->
    <section class="adb-section" id="ui" aria-labelledby="s8">
      <div class="adb-wrap">
        <div class="adb-slate">
          <span class="adb-slate__no">08</span>
          <div class="adb-slate__meta">
            <span class="adb-kicker">Grid &amp; UI</span>
            <h2 class="adb-slate__title" id="s8">
              Component sheet
            </h2>
          </div>
          <p class="adb-slate__note">
            Buttons, nav, links, card, and a form field in the After Dark voice. Square-cut 2px
            radius; sodium reserved for the primary action and focus.
          </p>
        </div>

        <div class="adb-ui">
          <!-- Buttons + links -->
          <div class="adb-uicell" data-reveal>
            <span class="adb-uicell__h">Actions &amp; links</span>
            <div class="adb-uibtns">
              <a class="adb-btn adb-btn--sodium" href="#ui">
                Start a project{' '}
                <span class="arw" aria-hidden="true">
                  &rarr;
                </span>
              </a>
              <a class="adb-btn adb-btn--ghost" href="#ui">
                See the work
              </a>
              <a class="adb-btn" href="#ui">
                Secondary
              </a>
            </div>
            <p style="margin:0;color:var(--tx);">
              Inline copy with a
              <a class="adb-inlink" href="#ui">
                sodium underline that wipes in
              </a>
              on hover — quiet until you reach for it.
            </p>
          </div>

          <!-- Nav -->
          <div class="adb-uicell" data-reveal>
            <span class="adb-uicell__h">Navigation</span>
            <nav class="adb-uinav" aria-label="Sample navigation (demo)">
              <span class="adb-uinav__brand">
                AFTER HOUR<b>Z</b>
              </span>
              <span class="adb-uinav__sp"></span>
              <a href="#ui">Work</a>
              <a href="#ui">Craft</a>
              <a href="#ui">Services</a>
              <a href="#ui">Contact</a>
            </nav>
            <p style="margin:0;color:var(--tx-mut);font-size:var(--text-caption);">
              Underline slides up in sodium on hover/focus. Collapses to brand + one action on
              mobile.
            </p>
          </div>

          <!-- Card -->
          <div class="adb-uicell" data-reveal>
            <span class="adb-uicell__h">Portfolio card</span>
            <article class="adb-uicard">
              <div
                class="adb-uicard__band"
                style="--mat:linear-gradient(118deg,transparent 34%,rgba(255,255,255,0.4) 47%,transparent 56%),linear-gradient(160deg,#0a2a52,#071a34);"
              ></div>
              <div class="adb-uicard__body">
                <span class="adb-uicard__k">Candy · restoration</span>
                <span class="adb-uicard__t">Body line, restored</span>
                <p class="adb-uicard__p">
                  Fixed ratio, one image, quiet label. Real builds only — placeholder shown.
                </p>
              </div>
            </article>
          </div>

          <!-- Form field -->
          <div class="adb-uicell" data-reveal>
            <span class="adb-uicell__h">Form field</span>
            <form
              onsubmit="return false;"
              aria-label="Sample field (demo, not wired)"
              style="display:grid;gap:var(--spacing-md);"
            >
              <div class="adb-field">
                <label for="adb-vehicle">Vehicle</label>
                <input
                  id="adb-vehicle"
                  type="text"
                  name="vehicle"
                  placeholder="Year · make · model"
                  autocomplete="off"
                />
              </div>
              <div class="adb-field">
                <label for="adb-msg">What do you want done?</label>
                <textarea
                  id="adb-msg"
                  name="msg"
                  rows="2"
                  placeholder="Paint, bodywork, restoration…"
                ></textarea>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         9 · MOTION NOTE
         ========================================================= -->
    <section class="adb-section" id="motion" aria-labelledby="s9">
      <div class="adb-wrap">
        <div class="adb-slate">
          <span class="adb-slate__no">09</span>
          <div class="adb-slate__meta">
            <span class="adb-kicker">Motion Note</span>
            <h2 class="adb-slate__title" id="s9">
              The thesis is momentum
            </h2>
          </div>
        </div>

        <div class="adb-motion">
          <div class="adb-motion__word" aria-hidden="true" data-reveal>
            MOMENTUM
          </div>
          <div class="adb-motion__body" data-reveal="side">
            <p>
              Where Chrome Heritage is <b>polish &amp; reflection</b> and Booth Light is
              <b>reveal &amp; exposure</b>, After Dark moves. Content <b>drifts sideways</b>
              into frame; dusk layers parallax at different rates; sections <b>cut</b> from one
              cinematic plate to the next like a night drive across town.
            </p>
            <p>
              One signature device, held everywhere else quiet: a slow horizontal drift. The strip
              below demonstrates it — it pauses on hover or focus, and freezes entirely under{' '}
              <b>prefers-reduced-motion</b>.
            </p>

            <div class="adb-drift">
              <div class="adb-drift__track">
                <div class="adb-drift__chip">
                  <b>STRIP &amp; ASSESS</b>
                  <span>Honest read on the metal</span>
                </div>
                <div class="adb-drift__chip">
                  <b>METAL &amp; BODY</b>
                  <span>Panels true, gaps set</span>
                </div>
                <div class="adb-drift__chip">
                  <b>BASE · CANDY · CLEAR</b>
                  <span>Depth in patient layers</span>
                </div>
                <div class="adb-drift__chip">
                  <b>CUT &amp; BUFF</b>
                  <span>Reflection runs flat</span>
                </div>
                <!-- duplicate set for seamless loop -->
                <div class="adb-drift__chip" aria-hidden="true">
                  <b>STRIP &amp; ASSESS</b>
                  <span>Honest read on the metal</span>
                </div>
                <div class="adb-drift__chip" aria-hidden="true">
                  <b>METAL &amp; BODY</b>
                  <span>Panels true, gaps set</span>
                </div>
                <div class="adb-drift__chip" aria-hidden="true">
                  <b>BASE · CANDY · CLEAR</b>
                  <span>Depth in patient layers</span>
                </div>
                <div class="adb-drift__chip" aria-hidden="true">
                  <b>CUT &amp; BUFF</b>
                  <span>Reflection runs flat</span>
                </div>
              </div>
              <p class="adb-drift__hint">Hover / focus to pause · reduced-motion freezes it</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         10 · COMPOSITION INTENT
         ========================================================= -->
    <section class="adb-section" id="comp" aria-labelledby="s10">
      <div class="adb-wrap">
        <div class="adb-slate">
          <span class="adb-slate__no">10</span>
          <div class="adb-slate__meta">
            <span class="adb-kicker">Composition Intent</span>
            <h2 class="adb-slate__title" id="s10">
              What Phase 3 will prove
            </h2>
          </div>
          <p class="adb-slate__note">
            Three labeled compositions the prototype must land — hero, mid-page story, closing CTA.
          </p>
        </div>

        <div class="adb-comp">
          <!-- HERO -->
          <figure class="adb-thumb" data-reveal>
            <div class="adb-thumb__frame" aria-hidden="true">
              <span class="adb-wire adb-wire--img" style="inset:0 0 0 42%;"></span>
              <span
                class="adb-wire adb-wire--type"
                style="left:8%;bottom:14%;width:40%;height:26%;"
              ></span>
              <span
                class="adb-wire adb-wire--fill"
                style="left:8%;bottom:6%;width:20%;height:5%;"
              ></span>
            </div>
            <figcaption class="adb-thumb__cap">
              <span class="adb-thumb__role">Hero</span>
              <span class="adb-thumb__t">Subject right, type left</span>
              <span class="adb-thumb__d">
                Vehicle emerges bottom-right from fog; headline + one CTA anchored lower-left in the
                negative space. Asymmetric, confident.
              </span>
            </figcaption>
          </figure>

          <!-- MID-PAGE STORY -->
          <figure class="adb-thumb" data-reveal data-delay="80">
            <div class="adb-thumb__frame" aria-hidden="true">
              <span
                class="adb-wire adb-wire--img"
                style="left:0;top:0;width:64%;height:58%;"
              ></span>
              <span
                class="adb-wire adb-wire--type"
                style="right:6%;top:14%;width:26%;height:20%;"
              ></span>
              <span
                class="adb-wire adb-wire--img"
                style="left:22%;bottom:8%;width:70%;height:34%;"
              ></span>
            </div>
            <figcaption class="adb-thumb__cap">
              <span class="adb-thumb__role">Mid-page story</span>
              <span class="adb-thumb__t">Overlapping drift band</span>
              <span class="adb-thumb__d">
                Two plates overlap on a horizontal drift; caption tucked into the offset. Scroll
                enacts the transformation, cut to cut.
              </span>
            </figcaption>
          </figure>

          <!-- CLOSING CTA -->
          <figure class="adb-thumb" data-reveal data-delay="160">
            <div class="adb-thumb__frame" aria-hidden="true">
              <span class="adb-wire adb-wire--fill" style="inset:0;"></span>
              <span
                class="adb-wire adb-wire--type"
                style="left:18%;top:34%;width:64%;height:20%;"
              ></span>
              <span
                class="adb-wire adb-wire--fill"
                style="left:38%;bottom:20%;width:24%;height:7%;background:rgba(255,157,77,0.4);border-style:solid;"
              ></span>
            </div>
            <figcaption class="adb-thumb__cap">
              <span class="adb-thumb__role">Closing CTA</span>
              <span class="adb-thumb__t">Sodium glow, centered</span>
              <span class="adb-thumb__d">
                Near-black field, a low warm glow rising from the base, wordmark-scale invitation
                and a single sodium button. Pull up.
              </span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
  </main>

