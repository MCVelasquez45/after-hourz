  <!-- Board-scoped exposure reveal: adds .is-revealed to [data-bl-reveal].
       Progressive + reduced-motion safe (see board CSS). Distinct hook from the
       shared [data-reveal] so this board's clip-reveal never collides with it. -->
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll<HTMLElement>('[data-bl-reveal]');
    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-revealed'));
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-revealed');
              obs.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
      );
      els.forEach((el) => io.observe(el));
    }
  </script>
