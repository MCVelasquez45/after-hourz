---
import BaseLayout from '../layouts/BaseLayout.astro';
// NOTE: This is intentionally NOT the production homepage (prompt §5, §27).
// It is a minimal internal entry that routes to the design lab.
---

<BaseLayout
  title="After Hourz — internal"
  description="Internal design environment. Not the public site."
>
  <main id="main" class="lab__booth" style="min-height:100dvh; display:grid; place-items:center;">
    <div
      class="lab__wrap"
      style="text-align:center; display:grid; gap:var(--spacing-md); max-width:48rem;"
    >
      <p class="spec-label">After Hourz · internal · not the public site</p>
      <h1 style="font-size:var(--text-display);">Design Lab</h1>
      <p style="margin-inline:auto; color:var(--color-aluminum);">
        This repository is in its foundation phase. The customer-facing experience has not been
        built. Everything here is an internal creative-development environment.
      </p>
      <p>
        <a
          class="btn btn--primary"
          href="/design-lab/"
          style="text-decoration:none; display:inline-block;"
        >
          Enter the Design Lab →
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
