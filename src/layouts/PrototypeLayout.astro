---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass: string;
}
const { title, description = 'After Hourz — design direction prototype.', bodyClass } = Astro.props;
// CLIENT-MODE-BY-DEFAULT: the deployed client-review build is compiled with
// PUBLIC_CLIENT_MODE=1, which bakes client mode on (no ?review query needed by Anthony).
// Local builds leave it unset → internal chrome shows; ?review=1 still toggles for testing.
const clientMode = import.meta.env.PUBLIC_CLIENT_MODE === '1';
// In client mode the browser tab shows just the brand (no internal direction name leak).
const displayTitle = clientMode ? 'After Hourz' : title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{displayTitle}</title>
    <script is:inline define:vars={{ clientMode }}>
      document.documentElement.classList.add('js');
      // CLIENT-REVIEW MODE. On the deployed build clientMode is baked true (Anthony needs no
      // query string). Locally, ?review=1 toggles it for testing. Runs before paint so no flash.
      try {
        const review = new URLSearchParams(window.location.search).get('review');
        if (clientMode || review === '1') {
          document.documentElement.dataset.review = '1';
        } else {
          delete document.documentElement.dataset.review;
        }
      } catch {
        if (clientMode) document.documentElement.dataset.review = '1';
      }
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />

    <!-- Reveal-on-scroll: small isolated JS, HTML-first, reduced-motion safe (docs/09). -->
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).style.setProperty(
                  '--reveal-delay',
                  `${Math.min(Number((e.target as HTMLElement).dataset.delay ?? 0), 400)}ms`,
                );
                e.target.classList.add('is-revealed');
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
