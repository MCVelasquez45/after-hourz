{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "test-results",
    "playwright-report",
    ".lighthouseci",
    "eslint.config.js",
    "*.config.js",
    "*.config.cjs",
    "lighthouserc.cjs"
  ],
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": true
  }
}
