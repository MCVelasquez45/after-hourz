{
  // After Hourz — TEMPORARY CLIENT-REVIEW Worker (design-lab only; NOT production).
  // Deploy via Wrangler from the local build (no GitHub push). Authorized for review only.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "after-hourz-client-review",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  // main + assets are managed by @astrojs/cloudflare (v14) / @cloudflare/vite-plugin.
  "observability": {
    "enabled": true,
  },
  // D1 — questionnaire storage. database_id is filled AFTER `wrangler d1 create after-hourz-review`
  // (requires Cloudflare auth). Local dev/tests use a local simulated D1 keyed by binding+name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "after-hourz-review",
      "database_id": "29acc075-33e2-474c-bce3-00bcc616771e",
      "migrations_dir": "migrations",
    },
  ],
  // KV for Astro sessions (adapter v14 auto-binds SESSION). Not used by the review flow,
  // but the binding must resolve for deploy.
  "kv_namespaces": [{ "binding": "SESSION", "id": "b211da884c9d4ad195b6627151f17cb9" }],
  // Private R2 bucket for optional client asset uploads (photos/docs). Worker-mediated only —
  // never public. DISABLED for now: R2 is not enabled on the Cloudflare account (error 10042),
  // and a bound-but-missing bucket makes `wrangler deploy` fail. The questionnaire deploys and
  // runs fine without it — the Uploader hides itself (PUBLIC_UPLOADS_ENABLED unset) and the
  // upload endpoint returns 503. TO RE-ENABLE UPLOADS: enable R2 in the dashboard, create the
  // bucket (`wrangler r2 bucket create after-hourz-review-assets`), un-comment the binding
  // below, and rebuild with PUBLIC_UPLOADS_ENABLED=1.
  // "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "after-hourz-review-assets" }],
  // Public Turnstile site key (safe to expose). The SECRET is set via `wrangler secret put
  // TURNSTILE_SECRET_KEY` (remote) or .dev.vars (local) — never committed.
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "REVIEW_CLIENT_SLUG": "after-hourz",
  },
}
